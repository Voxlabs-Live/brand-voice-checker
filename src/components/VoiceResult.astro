---
// VoiceResult — renders the band label, sub-scores, highlighted draft, flags,
// and rewrite. Client script populates the slots after a successful /api/check.
//
// Band is the headline (e.g. "Off brand"); composite_score is shown as a
// secondary detail underneath because LLM-judge literature is clear that
// fine-grained integer scores drift across runs while the band is stable.
---
<section class="result" hidden>
  <header class="result__head">
    <div class="band">
      <span class="band__label" data-field="band_label">—</span>
      <span class="band__meta">
        <span class="band__score" data-field="composite_score">—</span><span class="band__score-suffix">/100</span>
        <span class="band__confidence" data-field="confidence_badge" hidden></span>
      </span>
    </div>
    <div class="result__actions">
      <button class="btn btn--ghost btn--small" data-copy="rewrite">
        Copy rewritten draft
      </button>
      <button class="btn btn--ghost btn--small" data-copy="flags">
        Copy flags as comment
      </button>
    </div>
    <p class="band__reason" data-field="score_reason"></p>
  </header>

  <div class="subscores" data-field="subscores">
    <div class="subscore" data-key="vocabulary">
      <div class="subscore__head">
        <span class="subscore__label">Vocabulary</span>
        <span class="subscore__value"><span class="subscore__num">—</span><span class="subscore__max">/100</span></span>
      </div>
      <div class="subscore__bar"><div class="subscore__fill"></div></div>
    </div>
    <div class="subscore" data-key="punctuation">
      <div class="subscore__head">
        <span class="subscore__label">Punctuation</span>
        <span class="subscore__value"><span class="subscore__num">—</span><span class="subscore__max">/100</span></span>
      </div>
      <div class="subscore__bar"><div class="subscore__fill"></div></div>
    </div>
    <div class="subscore" data-key="tone">
      <div class="subscore__head">
        <span class="subscore__label">Tone</span>
        <span class="subscore__value"><span class="subscore__num">—</span><span class="subscore__max">/100</span></span>
      </div>
      <div class="subscore__bar"><div class="subscore__fill"></div></div>
    </div>
    <div class="subscore" data-key="cadence">
      <div class="subscore__head">
        <span class="subscore__label">Cadence</span>
        <span class="subscore__value"><span class="subscore__num">—</span><span class="subscore__max">/100</span></span>
      </div>
      <div class="subscore__bar"><div class="subscore__fill"></div></div>
    </div>
  </div>
  <p class="subscores__legend">Each score is out of 100 — higher means more on-brand.</p>

  <div class="result__body">
    <article class="draft-pane">
      <h3 class="block__h">Your draft</h3>
      <p class="draft" data-field="highlightedDraft"></p>
      <p class="empty-state" data-field="flagsEmptyDraft" hidden>
        Nothing flagged — this draft reads on-brand.
      </p>
    </article>
    <article class="flags-pane">
      <h3 class="block__h">Flags</h3>
      <ul class="flags" data-field="flags"></ul>
      <p class="empty-state" data-field="flagsEmpty" hidden>
        Zero flags. Ship it.
      </p>
    </article>
  </div>

  <article class="rewrite">
    <h3 class="block__h">Rewritten on-brand</h3>
    <p data-field="rewritten_draft"></p>
  </article>
</section>

<style>
  .result {
    background: var(--surface-0);
    border: 1px solid var(--surface-200);
    border-radius: var(--radius-lg);
    padding: 2rem;
    margin-top: 1.5rem;
    box-shadow: var(--shadow-card);
  }
  @media (max-width: 600px) { .result { padding: 1.5rem; } }

  .result__head {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "band actions"
      "reason reason";
    gap: 0.75rem 1.5rem;
    align-items: start;
    margin-bottom: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--surface-200);
  }

  .band {
    grid-area: band;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .band__label {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    line-height: 1.05;
    color: var(--surface-900);
  }
  /* Band-driven color: calm for on-brand, terracotta accent for off-brand,
     amber for the in-between. All within the locked Ember token set. */
  .band[data-band="on-brand"] .band__label { color: var(--surface-900); }
  .band[data-band="mostly-on-brand"] .band__label { color: var(--surface-800); }
  .band[data-band="drifting"] .band__label { color: var(--amber-700); }
  .band[data-band="off-brand"] .band__label { color: var(--accent-500); }
  .band[data-band="rewrite-needed"] .band__label { color: var(--accent-600); }

  .band__meta {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--surface-600);
  }
  .band__score { font-weight: var(--font-weight-semibold); color: var(--surface-700); }
  .band__score-suffix { color: var(--surface-500); }

  .band__confidence {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--surface-100);
    color: var(--surface-700);
  }
  .band__confidence[data-confidence="medium"] {
    background: oklch(from var(--amber-300) l c h / 0.35);
    color: var(--amber-700);
  }
  .band__confidence[data-confidence="low"] {
    background: oklch(from var(--accent-200) l c h / 0.55);
    color: var(--accent-800);
  }

  .band__reason {
    grid-area: reason;
    color: var(--surface-700);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    max-width: 75ch;
  }

  .result__actions {
    grid-area: actions;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-self: end;
  }

  /* Sub-scores ──────────────────────────────────────── */
  .subscores {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 0.6rem;
  }
  .subscores__legend {
    margin: 0 0 1.75rem;
    font-size: var(--text-xs);
    color: var(--surface-500);
  }
  @media (max-width: 760px) {
    .subscores { grid-template-columns: repeat(2, 1fr); }
  }
  .subscore {
    background: var(--surface-50);
    border: 1px solid var(--surface-200);
    border-radius: var(--radius);
    padding: 0.7rem 0.85rem 0.85rem;
  }
  /* Label stacked above the score, left-aligned, in every card. The old
     label-left / value-right (space-between) layout left no gap when a long
     label (VOCABULARY, PUNCTUATION) nearly filled the card, so the number butt
     right up against it. Stacking is uniform and never collides at any width. */
  .subscore__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }
  .subscore__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--surface-700);
  }
  .subscore__value {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--surface-900);
  }
  .subscore__max {
    font-weight: 400;
    font-size: var(--text-xs);
    color: var(--surface-500);
    margin-left: 0.05rem;
  }
  .subscore__bar {
    background: var(--surface-200);
    border-radius: 999px;
    height: 6px;
    overflow: hidden;
    margin-bottom: 0.35rem;
  }
  .subscore__fill {
    background: var(--surface-900);
    height: 100%;
    width: 0%;
    transition: width 0.35s ease, background 0.2s;
    border-radius: 999px;
  }
  .subscore[data-band="drifting"] .subscore__fill { background: var(--amber-600); }
  .subscore[data-band="off-brand"] .subscore__fill { background: var(--accent-500); }
  .subscore[data-band="rewrite-needed"] .subscore__fill { background: var(--accent-600); }

  /* Draft + flags split ─────────────────────────────── */
  .result__body {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 1.5rem;
  }
  @media (max-width: 760px) {
    .result__body { grid-template-columns: 1fr; }
  }

  .block__h {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    margin-bottom: 0.75rem;
  }

  .draft {
    background: var(--surface-50);
    border: 1px solid var(--surface-200);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    line-height: var(--leading-relaxed);
    color: var(--surface-900);
    white-space: pre-wrap;
  }
  .draft :global(mark) {
    background: oklch(from var(--accent-100) l c h / 0.85);
    color: var(--accent-800);
    border-bottom: 1.5px solid var(--accent-500);
    padding: 0.05em 0.18em;
    border-radius: 2px;
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  /* .flags / .flag__* styles live in global.css — the flag list items are
   * created dynamically by the render() function in index.astro via
   * document.createElement, so Astro's auto-scoped data-attribute selectors
   * never apply to them. Same trap as .form-row. */

  .rewrite {
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--surface-200);
  }
  .rewrite p {
    background: oklch(from var(--amber-300) l c h / 0.18);
    border-radius: var(--radius);
    padding: 1rem 1.15rem;
    line-height: var(--leading-relaxed);
    color: var(--surface-900);
    white-space: pre-wrap;
  }

  .empty-state {
    font-style: italic;
    color: var(--surface-500);
    font-size: var(--text-sm);
  }
</style>
