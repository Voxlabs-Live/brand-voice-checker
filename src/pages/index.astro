---
import ToolLayout from "../layouts/ToolLayout.astro";
import LoadingStages from "../components/LoadingStages.astro";
import RateLimitWall from "../components/RateLimitWall.astro";
import VoiceResult from "../components/VoiceResult.astro";
import VoiceDocForm from "../components/VoiceDocForm.astro";
import VoiceDocPicker from "../components/VoiceDocPicker.astro";
import VoiceDocSummary from "../components/VoiceDocSummary.astro";
import UploadDoc from "../components/UploadDoc.astro";
import DocCritiquePanel from "../components/DocCritiquePanel.astro";

const REPO_URL = "https://github.com/Voxlabs-Live/brand-voice-checker";
---
<ToolLayout
  toolName="Brand Voice Checker"
  description="Build a structured voice doc per client, save it, and check drafts against it. Every flag comes with the cited rule, scored across vocabulary, punctuation, tone, and cadence. Part of the Agency Vibe-Coding Kit."
  repoUrl={REPO_URL}
>
  <h1 class="tool-title">
    Catch off-brand copy before it goes to the <em>client</em>.
  </h1>
  <p class="tool-lede">
    Build a voice doc for each client, then check drafts against it. Flags
    cite the specific rule each violation breaks.
  </p>

  <!-- ─── STAGE 01 — Voice doc ─────────────────────────────────────────── -->
  <section class="stage" data-stage="voice-doc" data-mode="empty">
    <header class="stage__head">
      <span class="stage__num">01</span>
      <h2 class="stage__title">Voice doc</h2>
      <span class="stage__status" data-stage-status>Pick how to start</span>
    </header>

    <!-- Empty state: no saved docs -->
    <div class="stage__body stage__body--empty" data-mode-view="empty">
      <p class="stage-empty__lead">
        Build a structured voice doc — the tool needs this to score drafts.
        Pick how you want to start:
      </p>
      <div class="stage-empty__actions">
        <button type="button" class="card-btn" data-empty-build>
          <span class="card-btn__title">Build from scratch</span>
          <span class="card-btn__desc">Walk through 10 sections in the form. Takes about 30 minutes with your client.</span>
        </button>
        <button type="button" class="card-btn" data-empty-import>
          <span class="card-btn__title">Import existing doc</span>
          <span class="card-btn__desc">Drop a PDF, Word, or Markdown doc. We'll extract what we can and critique the rest.</span>
        </button>
        <button type="button" class="card-btn" data-empty-sample>
          <span class="card-btn__title">Try a sample</span>
          <span class="card-btn__desc">Load Aurelia Lashes, Mantra Yoga, or Dr. Eckhardt Clinic to see scoring in action.</span>
        </button>
      </div>
      <div class="stage-empty__samples" data-empty-samples hidden>
        <p class="stage-empty__hint">Pick a sample:</p>
        <div class="samples" data-samples-row></div>
      </div>
    </div>

    <!-- Summary state: doc selected, not editing -->
    <div class="stage__body stage__body--summary" data-mode-view="summary" hidden>
      <VoiceDocSummary />
    </div>

    <!-- Editing state: full form + picker + upload + critique.
         When data-import-only="true", picker/samples/form are hidden so the
         user can focus on the upload drop area. Removed automatically after
         a successful import. -->
    <div class="stage__body stage__body--editing" data-mode-view="editing" hidden>
      <p class="import-only-lead" data-import-lead hidden>
        Drop your existing voice doc below. We'll extract the structured
        fields and show you what's missing — you'll review everything before
        anything saves.
      </p>
      <div data-editing-picker>
        <VoiceDocPicker />
        <details class="samples-details">
          <summary class="samples-details__summary">Try with a built-in sample →</summary>
          <div class="samples" data-samples-row-editing></div>
        </details>
      </div>
      <UploadDoc />
      <DocCritiquePanel />
      <div data-editing-form>
        <VoiceDocForm />
      </div>
      <p class="import-only-escape" data-import-escape hidden>
        Or <a href="#" data-import-switch-build>build from scratch instead →</a>
      </p>
      <div class="stage__footer">
        <button type="button" class="btn btn--ghost" data-editing-cancel>Cancel</button>
        <button type="button" class="btn btn--primary" data-editing-done>Done editing →</button>
      </div>
    </div>
  </section>

  <!-- ─── STAGE 02 — Draft ─────────────────────────────────────────────── -->
  <section class="stage" data-stage="draft">
    <header class="stage__head">
      <span class="stage__num">02</span>
      <h2 class="stage__title">Draft to check</h2>
      <span class="stage__status" data-draft-target></span>
    </header>
    <div class="stage__body">
      <label class="field-label visually-hidden" for="draft">Draft to check</label>
      <textarea
        class="input"
        id="draft"
        name="draft"
        placeholder="Paste the draft copy you want to check — caption, email, post, anything client-facing..."
        rows="6"
      ></textarea>
      <p class="draft__sample-hint" data-sample-hint hidden>
        <button type="button" class="draft__sample-hint-btn" data-load-sample-draft>
          Try the matching sample draft &rarr;
        </button>
      </p>
      <div class="actions">
        <button class="btn btn--primary" id="submit">Check voice fit &rarr;</button>
        <LoadingStages stages={["Reading", "Scoring", "Done"]} />
        <span class="actions__hint" id="hint"></span>
      </div>
    </div>
  </section>

  <!-- ─── STAGE 03 — Result (revealed after first submit) ──────────────── -->
  <section class="stage stage--result" data-stage="result" hidden>
    <header class="stage__head">
      <span class="stage__num">03</span>
      <h2 class="stage__title">Result</h2>
    </header>
    <div class="stage__body">
      <VoiceResult />
    </div>
  </section>

  <RateLimitWall repoUrl={REPO_URL} />
</ToolLayout>

<style>
  /* Stage layout — three vertical cards with numbered headers. */
  .stage {
    background: var(--surface-0);
    border: 1px solid var(--surface-200);
    border-radius: var(--radius-lg);
    margin-bottom: 1rem;
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .stage:last-of-type { margin-bottom: 0; }

  .stage__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1.5rem;
    border-bottom: 1px solid var(--surface-150);
    background: var(--surface-50);
  }
  .stage__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--surface-500);
    letter-spacing: 0.05em;
  }
  .stage__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    margin: 0;
    color: var(--surface-900);
  }
  .stage__status {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--surface-600);
    text-align: right;
  }
  .stage__body {
    padding: 1.25rem 1.5rem 1.5rem;
  }
  .stage__body--empty,
  .stage__body--summary {
    padding: 1.25rem 1.5rem 1.5rem;
  }
  .stage__footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--surface-200);
  }

  /* Active stage gets a stronger left-edge treatment so the eye knows where
     to go without changing the overall card style. */
  .stage[data-active="true"] {
    border-color: var(--surface-300);
    box-shadow: var(--shadow-lg);
  }

  /* ─── Empty-state CTAs ──────────────────────────────────────────────── */
  .stage-empty__lead {
    margin: 0 0 1rem;
    color: var(--surface-700);
    font-size: var(--text-base);
  }
  .stage-empty__actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  @media (max-width: 760px) {
    .stage-empty__actions { grid-template-columns: 1fr; }
  }
  .card-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    text-align: left;
    background: var(--surface-50);
    border: 1px solid var(--surface-200);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
    cursor: pointer;
    transition: border-color 0.12s, background 0.12s, transform 0.08s;
    font-family: inherit;
    color: inherit;
  }
  .card-btn:hover {
    border-color: var(--accent-400);
    background: oklch(from var(--accent-50) l c h / 0.6);
  }
  .card-btn:active { transform: translateY(1px); }
  .card-btn__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--surface-900);
  }
  .card-btn__desc {
    font-size: var(--text-sm);
    color: var(--surface-700);
    line-height: var(--leading-normal);
  }
  .stage-empty__samples {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--surface-200);
  }
  .stage-empty__hint {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--surface-600);
  }
  .samples {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  /* ─── Editing-mode trimmings ────────────────────────────────────────── */
  .samples-details {
    margin: 0.5rem 0 1rem;
  }
  .samples-details__summary {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--surface-700);
    cursor: pointer;
    padding: 0.4rem 0;
    list-style: none;
  }
  .samples-details__summary::-webkit-details-marker { display: none; }
  .samples-details[open] .samples-details__summary { margin-bottom: 0.5rem; }

  /* The form inside editing mode loses its own outer card chrome since the
     stage is already a card. */
  .stage__body--editing .voice-form {
    box-shadow: none;
    border-color: var(--surface-150);
  }

  /* ─── Import-only sub-state ────────────────────────────────────────────
     Triggered when user clicks "Import existing doc". Hides everything
     except the upload drop area so the focus is on the file. The form
     reveals once applyImport() completes. */
  .stage__body--editing[data-import-only="true"] [data-editing-picker],
  .stage__body--editing[data-import-only="true"] [data-editing-form],
  .stage__body--editing[data-import-only="true"] [data-editing-done] {
    display: none;
  }
  .import-only-lead {
    margin: 0 0 0.85rem;
    color: var(--surface-700);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
  .import-only-escape {
    margin: 1rem 0 0;
    font-size: var(--text-sm);
    color: var(--surface-600);
    text-align: center;
  }
  .import-only-escape a {
    color: var(--accent-600);
    font-weight: var(--font-weight-semibold);
  }
  .import-only-escape a:hover { color: var(--accent-700); }

  /* In import-only mode, lift the upload area visually so the user knows
     it's the primary action. */
  .stage__body--editing[data-import-only="true"] .upload {
    border-color: var(--surface-300);
    background: var(--surface-0);
  }
  .stage__body--editing[data-import-only="true"] .upload__drop {
    padding: 2.5rem 1.5rem;
  }

  /* "Try the matching sample draft" — surfaces in the Draft card when a
   * sample voice doc is active and the textarea is empty. Only path to the
   * matching off-brand caption now that the dropdown switcher exists; the
   * empty-state CTA still auto-fills on first click. */
  .draft__sample-hint {
    margin: 0.5rem 0 0;
    font-size: var(--text-sm);
    color: var(--surface-500);
  }
  .draft__sample-hint-btn {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--surface-700);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--surface-300);
  }
  .draft__sample-hint-btn:hover {
    color: var(--surface-900);
    text-decoration-color: currentColor;
  }

  /* Visually hide a label but keep it for screen readers. */
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { VOICE_SAMPLES, SAMPLE_DOCS } from "../fixtures/studio-north";
  import {
    seedSamplesIfNeeded,
    listDocs,
    getDoc,
    saveDoc,
    deleteDoc,
    duplicateDoc,
    saveImportCritique,
    loadImportCritique,
    clearImportCritique,
    SAMPLE_ID_PREFIX,
  } from "../lib/voice-doc-storage";
  import {
    emptyVoiceDoc,
    type VoiceDoc,
  } from "../lib/voice-doc-schema";
  import { computeDocStrength } from "../lib/voice-doc-strength";
  import { mountForm, type FormHandle } from "../lib/voice-doc-form";
  import type { VoiceResult, VoiceFlagCategory } from "../lib/voice-types";
  import type { ApiResponse } from "../lib/types";
  import type { ImportResult } from "./api/import-doc";

  type Mode = "empty" | "summary" | "editing";
  let mode: Mode = "empty";
  /** The doc the user is currently scoring against (and editing, in editing mode). */
  let currentDoc: VoiceDoc = emptyVoiceDoc();
  /** Snapshot used to detect unsaved changes when "Done editing" or "Cancel" is clicked. */
  let editingBaselineId = "";
  /**
   * If the textarea currently holds a sample draft, this is the id of the sample
   * (voice doc id) it came from. Null when the textarea is empty or contains
   * user-typed content. Read by syncDraftToActiveDoc() to keep sample drafts in
   * lockstep with their parent sample when the user switches via the dropdown —
   * without ever clobbering a user-typed draft. Declared early to dodge the
   * temporal dead zone, since setMode runs during bootstrap.
   */
  let draftSampleId: string | null = null;

  const $ = (sel: string) => document.querySelector(sel) as HTMLElement | null;
  const draftInput = $("#draft") as HTMLTextAreaElement;
  const submitBtn = $("#submit") as HTMLButtonElement;
  const hint = $("#hint");
  const sampleDraftHint = $('[data-sample-hint]') as HTMLElement;
  const loadSampleDraftBtn = $('[data-load-sample-draft]') as HTMLButtonElement;
  const loading = document.querySelector(".loading") as HTMLElement | null;
  const resultPanel = document.querySelector(".result") as HTMLElement | null;
  const resultStage = document.querySelector('[data-stage="result"]') as HTMLElement | null;
  const wall = document.querySelector(".wall") as HTMLElement | null;

  const stageVoiceDoc = document.querySelector('[data-stage="voice-doc"]') as HTMLElement;
  const stageStatus = stageVoiceDoc.querySelector('[data-stage-status]') as HTMLElement;
  const draftStatus = document.querySelector('[data-draft-target]') as HTMLElement;
  const emptyView = stageVoiceDoc.querySelector('[data-mode-view="empty"]') as HTMLElement;
  const summaryView = stageVoiceDoc.querySelector('[data-mode-view="summary"]') as HTMLElement;
  const editingView = stageVoiceDoc.querySelector('[data-mode-view="editing"]') as HTMLElement;

  // Empty-state controls.
  const emptyBuildBtn = stageVoiceDoc.querySelector('[data-empty-build]') as HTMLButtonElement;
  const emptyImportBtn = stageVoiceDoc.querySelector('[data-empty-import]') as HTMLButtonElement;
  const emptySampleBtn = stageVoiceDoc.querySelector('[data-empty-sample]') as HTMLButtonElement;
  const emptySamplesBox = stageVoiceDoc.querySelector('[data-empty-samples]') as HTMLElement;
  const emptySamplesRow = stageVoiceDoc.querySelector('[data-samples-row]') as HTMLElement;

  // Summary controls.
  const summaryRoot = summaryView.querySelector('[data-doc-summary]') as HTMLElement;
  const summaryClient = summaryRoot.querySelector('[data-summary-client]') as HTMLElement;
  const summaryVertical = summaryRoot.querySelector('[data-summary-vertical]') as HTMLElement;
  const summaryScore = summaryRoot.querySelector('[data-summary-score]') as HTMLElement;
  const summaryTone = summaryRoot.querySelector('[data-summary-tone]') as HTMLElement;
  const summaryStats = summaryRoot.querySelector('[data-summary-stats]') as HTMLElement;
  const summaryEditBtn = summaryRoot.querySelector('[data-summary-edit]') as HTMLButtonElement;
  const summarySwitcher = summaryRoot.querySelector('[data-summary-switcher]') as HTMLSelectElement;
  const summaryNewBtn = summaryRoot.querySelector('[data-summary-new]') as HTMLButtonElement;
  const summaryImportBtn = summaryRoot.querySelector('[data-summary-import]') as HTMLButtonElement;

  // Editing controls.
  const formRoot = editingView.querySelector('.voice-form') as HTMLElement;
  const pickerSelect = editingView.querySelector('[data-picker-select]') as HTMLSelectElement;
  const pickerStatus = editingView.querySelector('[data-picker-status]') as HTMLElement;
  const pickerNew = editingView.querySelector('[data-picker-new]') as HTMLButtonElement;
  const pickerDup = editingView.querySelector('[data-picker-duplicate]') as HTMLButtonElement;
  const pickerDel = editingView.querySelector('[data-picker-delete]') as HTMLButtonElement;
  const pickerSave = editingView.querySelector('[data-picker-save]') as HTMLButtonElement;
  const editingSamplesRow = editingView.querySelector('[data-samples-row-editing]') as HTMLElement;
  const samplesDetails = editingView.querySelector('.samples-details') as HTMLDetailsElement | null;
  const strengthBox = formRoot.querySelector('[data-field="strength_meter"]') as HTMLElement;
  const strengthScore = formRoot.querySelector('[data-field="strength_score"]') as HTMLElement;
  const strengthSummary = formRoot.querySelector('[data-field="strength_summary"]') as HTMLElement;
  const strengthBreakdownBtn = formRoot.querySelector('[data-strength-breakdown]') as HTMLButtonElement;
  const doneEditingBtn = editingView.querySelector('[data-editing-done]') as HTMLButtonElement;
  const cancelEditingBtn = editingView.querySelector('[data-editing-cancel]') as HTMLButtonElement;
  const uploadDetails = editingView.querySelector('[data-upload]') as HTMLDetailsElement | null;
  const uploadDrop = editingView.querySelector('[data-upload-drop]') as HTMLElement | null;
  const uploadInput = editingView.querySelector('[data-upload-input]') as HTMLInputElement | null;
  const uploadStatus = editingView.querySelector('[data-upload-status]') as HTMLElement | null;
  const critiquePanel = editingView.querySelector('[data-critique]') as HTMLElement | null;

  const form: FormHandle = mountForm(formRoot);
  let autosaveTimer: number | undefined;
  form.onChange((doc) => {
    currentDoc = doc;
    updateStrengthMeter();
    updateStartingPointsVisibility();
    scheduleAutosave();
  });

  // Bootstrap.
  seedSamplesIfNeeded(SAMPLE_DOCS);
  populateAllSamplesRows();
  populatePickerSelect();
  populateSummarySwitcher();
  initialMode();

  // Safety net for the one case auto-save can't cover: a brand-new, still-
  // unnamed doc with content can't be persisted (save needs a client name).
  // Anything named is flushed synchronously here before the page unloads.
  window.addEventListener("beforeunload", (e) => {
    flushAutosave();
    if (mode === "editing") {
      const doc = form.readDoc();
      if (
        !doc.id.startsWith(SAMPLE_ID_PREFIX) &&
        !doc.client_name.trim() &&
        docHasContent(doc)
      ) {
        e.preventDefault();
        e.returnValue = "";
      }
    }
  });

  function initialMode(): void {
    const docs = listDocs();
    if (docs.length === 0) {
      setMode("empty");
    } else {
      currentDoc = docs[0];
      pickerSelect.value = currentDoc.id;
      form.setDoc(currentDoc);
      summarySwitcher.value = currentDoc.id;
      setMode("summary");
    }
  }

  function setMode(next: Mode): void {
    mode = next;
    stageVoiceDoc.dataset.mode = next;
    emptyView.hidden = next !== "empty";
    summaryView.hidden = next !== "summary";
    editingView.hidden = next !== "editing";
    stageVoiceDoc.dataset.active = next === "editing" ? "true" : "false";
    refreshStageStatus();
    refreshDraftTarget();
    syncDraftToActiveDoc(); // must run before submit + hint refresh see textarea state
    updateSubmitEnabled();
    refreshSampleDraftHint();
    if (next === "summary") renderSummary();
  }

  function refreshStageStatus(): void {
    if (mode === "empty") {
      stageStatus.textContent = "Pick how to start";
    } else if (mode === "summary") {
      stageStatus.textContent = "Ready";
    } else {
      stageStatus.textContent = "Editing";
    }
  }

  function refreshDraftTarget(): void {
    if (mode === "summary" && currentDoc.client_name) {
      draftStatus.textContent = `Scoring against ${currentDoc.client_name}`;
    } else if (mode === "editing") {
      draftStatus.textContent = "Finish editing the voice doc first";
    } else {
      draftStatus.textContent = "No voice doc yet";
    }
  }

  function updateSubmitEnabled(): void {
    const docOk =
      currentDoc.client_name.trim() &&
      (currentDoc.banned_words.length > 0 ||
        currentDoc.voice_on_examples.length > 0);
    const draftOk = draftInput.value.trim().length > 0;
    const enabled = !!docOk && draftOk && mode !== "editing";
    submitBtn.disabled = !enabled;
  }
  draftInput.addEventListener("input", () => {
    // Any keystroke = the user has taken ownership. Stop auto-syncing the
    // textarea when the active voice doc changes from here on.
    draftSampleId = null;
    updateSubmitEnabled();
    refreshSampleDraftHint();
  });

  /** Return the matching sample for the currently active doc, if it's a sample. */
  function currentSampleDraft(): string | undefined {
    if (!currentDoc.id?.startsWith(SAMPLE_ID_PREFIX)) return undefined;
    const match = VOICE_SAMPLES.find((s) => s.voiceDoc.id === currentDoc.id);
    return match?.draft;
  }
  function refreshSampleDraftHint(): void {
    const sampleDraft = currentSampleDraft();
    const draftEmpty = draftInput.value.trim().length === 0;
    sampleDraftHint.hidden = !(sampleDraft && draftEmpty && mode === "summary");
  }
  /**
   * Keep a sample-loaded draft in sync with the active voice doc.
   * - Draft is user-typed (draftSampleId === null) → do nothing. Always.
   * - Draft already matches the active doc → do nothing.
   * - Active doc is a different sample → swap draft to its matching caption.
   * - Active doc is a user-created client doc → clear the orphaned sample draft.
   */
  function syncDraftToActiveDoc(): void {
    if (!draftSampleId || draftSampleId === currentDoc.id) return;
    const sampleDraft = currentSampleDraft();
    if (sampleDraft) {
      draftInput.value = sampleDraft;
      draftSampleId = currentDoc.id;
    } else {
      draftInput.value = "";
      draftSampleId = null;
    }
  }
  loadSampleDraftBtn.addEventListener("click", () => {
    const sampleDraft = currentSampleDraft();
    if (!sampleDraft) return;
    draftInput.value = sampleDraft;
    draftSampleId = currentDoc.id;
    updateSubmitEnabled();
    refreshSampleDraftHint();
    draftInput.focus();
  });

  // ─── Sample buttons (empty state + editing mode) ────────────────────
  function populateAllSamplesRows(): void {
    for (const row of [emptySamplesRow, editingSamplesRow]) {
      if (!row) continue;
      row.innerHTML = "";
      for (const s of VOICE_SAMPLES) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "btn btn--ghost btn--small";
        btn.textContent = s.client;
        btn.addEventListener("click", () => {
          // Make sure the sample doc is saved (it should be from seedSamples,
          // but the on-brand control shares Aurelia's id so we re-resolve).
          const sourceId = s.voiceDoc.id;
          let saved = getDoc(sourceId);
          if (!saved) saved = saveDoc(s.voiceDoc);
          currentDoc = saved;
          form.setDoc(saved);
          draftInput.value = s.draft;
          // Tag the textarea so subsequent dropdown switches keep it in sync.
          draftSampleId = saved.id;
          populatePickerSelect();
          populateSummarySwitcher();
          pickerSelect.value = saved.id;
          summarySwitcher.value = saved.id;
          setMode("summary");
          updateStrengthMeter();
          updateSubmitEnabled();
        });
        row.appendChild(btn);
      }
    }
  }

  // ─── Empty-state actions ─────────────────────────────────────────────
  emptyBuildBtn.addEventListener("click", () => {
    currentDoc = emptyVoiceDoc();
    form.setDoc(currentDoc);
    editingBaselineId = "";
    if (uploadDetails) uploadDetails.open = false;
    exitImportOnlyMode();
    setMode("editing");
    setPickerStatus("New blank doc — add a client name and it saves automatically as you go.", "warn");
  });
  emptyImportBtn.addEventListener("click", () => {
    currentDoc = emptyVoiceDoc();
    form.setDoc(currentDoc);
    editingBaselineId = "";
    enterImportOnlyMode();
  });
  emptySampleBtn.addEventListener("click", () => {
    emptySamplesBox.hidden = false;
    emptySamplesBox.scrollIntoView({ behavior: "smooth", block: "center" });
  });

  // ─── Summary actions ─────────────────────────────────────────────────
  summaryEditBtn.addEventListener("click", () => {
    editingBaselineId = currentDoc.id;
    pickerSelect.value = currentDoc.id;
    form.setDoc(currentDoc);
    exitImportOnlyMode();
    setMode("editing");
    setPickerStatus("");
    // Restore the critique panel for this doc if a previous import was saved,
    // or hide any stale panel left over from a different session.
    maybeRestoreCritique(currentDoc);
  });
  summarySwitcher.addEventListener("change", () => {
    const doc = getDoc(summarySwitcher.value);
    if (doc) {
      currentDoc = doc;
      pickerSelect.value = doc.id;
      form.setDoc(doc);
      setMode("summary");
    }
  });
  summaryNewBtn.addEventListener("click", () => {
    currentDoc = emptyVoiceDoc();
    form.setDoc(currentDoc);
    editingBaselineId = "";
    if (uploadDetails) uploadDetails.open = false;
    exitImportOnlyMode();
    setMode("editing");
    setPickerStatus("New blank doc — add a client name and it saves automatically as you go.", "warn");
  });
  summaryImportBtn.addEventListener("click", () => {
    currentDoc = emptyVoiceDoc();
    form.setDoc(currentDoc);
    editingBaselineId = "";
    enterImportOnlyMode();
  });

  /** Switch to editing mode with everything except the upload drop area
      hidden, so the user can focus on the file drop. Cleared after a
      successful import or when the user clicks Cancel / build-from-scratch. */
  function enterImportOnlyMode(): void {
    if (uploadDetails) uploadDetails.open = true;
    setMode("editing");
    editingView.dataset.importOnly = "true";
    const lead = editingView.querySelector('[data-import-lead]') as HTMLElement;
    const escape = editingView.querySelector('[data-import-escape]') as HTMLElement;
    if (lead) lead.hidden = false;
    if (escape) escape.hidden = false;
    setPickerStatus("");
    editingView.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function exitImportOnlyMode(): void {
    delete editingView.dataset.importOnly;
    const lead = editingView.querySelector('[data-import-lead]') as HTMLElement;
    const escape = editingView.querySelector('[data-import-escape]') as HTMLElement;
    if (lead) lead.hidden = true;
    if (escape) escape.hidden = true;
  }

  // "Build from scratch instead" escape link inside the import-only view.
  const importSwitchBuild = editingView.querySelector('[data-import-switch-build]') as HTMLAnchorElement | null;
  if (importSwitchBuild) {
    importSwitchBuild.addEventListener("click", (e) => {
      e.preventDefault();
      exitImportOnlyMode();
      if (uploadDetails) uploadDetails.open = false;
      setPickerStatus("New blank doc — add a client name and it saves automatically as you go.", "warn");
    });
  }

  // ─── Editing-mode picker + form interactions ─────────────────────────
  pickerSelect.addEventListener("change", () => {
    // Capture the target BEFORE flushing — flushAutosave() can call
    // syncPickerOption(), which resets pickerSelect.value to the doc we're
    // leaving. Without this capture, the switch would reload the old doc.
    const targetId = pickerSelect.value;
    flushAutosave(); // persist any pending edits before switching away
    const doc = getDoc(targetId);
    if (doc) {
      currentDoc = doc;
      pickerSelect.value = targetId; // restore in case flush moved it
      form.setDoc(doc);
      updateStrengthMeter();
      setPickerStatus("");
      // Show stored critique for the incoming doc, or hide the panel if none.
      // Without this, switching docs left the previous import's panel visible.
      maybeRestoreCritique(doc);
    }
  });
  pickerNew.addEventListener("click", () => {
    const blank = emptyVoiceDoc();
    currentDoc = blank;
    form.setDoc(blank);
    pickerSelect.value = "";
    updateStrengthMeter();
    setPickerStatus("New blank doc — add a client name and it saves automatically as you go.", "warn");
  });
  pickerDup.addEventListener("click", () => {
    if (!pickerSelect.value) {
      setPickerStatus("Select a doc to duplicate.", "warn");
      return;
    }
    const copy = duplicateDoc(pickerSelect.value);
    if (copy) {
      currentDoc = copy;
      populatePickerSelect();
      populateSummarySwitcher();
      pickerSelect.value = copy.id;
      form.setDoc(copy);
      updateStrengthMeter();
      setPickerStatus(`Duplicated as "${copy.client_name}".`, "saved");
    }
  });
  pickerDel.addEventListener("click", () => {
    const id = pickerSelect.value;
    if (!id) {
      setPickerStatus("Select a doc to delete.", "warn");
      return;
    }
    if (id.startsWith(SAMPLE_ID_PREFIX)) {
      setPickerStatus(
        "Sample docs can't be deleted (they re-seed on next visit). Duplicate it first if you want to modify.",
        "warn"
      );
      return;
    }
    const doc = getDoc(id);
    if (!doc) return;
    if (!confirm(`Delete "${doc.client_name}"? This can't be undone.`)) return;
    deleteDoc(id);
    populatePickerSelect();
    populateSummarySwitcher();
    // Reset to first remaining doc.
    const remaining = listDocs();
    if (remaining.length > 0) {
      currentDoc = remaining[0];
      pickerSelect.value = currentDoc.id;
      form.setDoc(currentDoc);
    } else {
      currentDoc = emptyVoiceDoc();
      form.setDoc(currentDoc);
    }
    updateStrengthMeter();
    setPickerStatus("Deleted.", "saved");
  });
  // Auto-save replaces the manual "Save changes" button — hide it and let the
  // status line communicate save state. (Handler kept harmless in case it's
  // ever surfaced again.)
  pickerSave.hidden = true;
  pickerSave.addEventListener("click", () => {
    const saved = persistCurrent();
    if (saved) setPickerStatus(`Saved "${saved.client_name}".`, "saved");
  });

  doneEditingBtn.addEventListener("click", () => {
    const saved = persistCurrent();
    if (!saved) return; // validation failed; stay in editing
    currentDoc = saved;
    exitImportOnlyMode();
    populatePickerSelect();
    populateSummarySwitcher();
    summarySwitcher.value = saved.id;
    setMode("summary");
  });
  cancelEditingBtn.addEventListener("click", () => {
    exitImportOnlyMode();
    if (editingBaselineId) {
      const baseline = getDoc(editingBaselineId);
      if (baseline) {
        currentDoc = baseline;
        form.setDoc(baseline);
        setMode("summary");
        return;
      }
    }
    // No baseline (was creating a new doc) — back to empty if no saved docs,
    // else go to summary with first doc.
    const docs = listDocs();
    if (docs.length === 0) setMode("empty");
    else {
      currentDoc = docs[0];
      pickerSelect.value = currentDoc.id;
      form.setDoc(currentDoc);
      setMode("summary");
    }
  });

  function persistCurrent(): VoiceDoc | null {
    const doc = form.readDoc();
    if (!doc.client_name.trim()) {
      setPickerStatus("Add a client name before saving.", "warn");
      return null;
    }
    return saveDoc(doc);
  }

  function setPickerStatus(message: string, state?: "saved" | "warn"): void {
    pickerStatus.textContent = message;
    if (state) pickerStatus.dataset.state = state;
    else delete pickerStatus.dataset.state;
  }

  // ─── Auto-save ───────────────────────────────────────────────────────
  // Edits persist automatically (debounced). The dirty check compares the
  // live form against the STORED doc of the same id, so programmatic loads
  // (which match storage) never trigger a save — only real edits and applied
  // suggestions do. Samples are read-only demo seeds and never auto-save.
  function docHasContent(doc: VoiceDoc): boolean {
    return (
      doc.tone_words.some((t) => t.trim()) ||
      doc.banned_words.length > 0 ||
      doc.cadence_rules.length > 0 ||
      doc.voice_on_examples.length > 0 ||
      doc.voice_off_examples.length > 0 ||
      doc.required_terms.length > 0 ||
      doc.examples_gallery.length > 0
    );
  }

  function setSaveStatus(state: "saving" | "saved" | "needs-name"): void {
    if (state === "saving") setPickerStatus("Saving…");
    else if (state === "saved") setPickerStatus("✓ All changes saved automatically", "saved");
    else setPickerStatus("Add a client name — edits save automatically once it's named.", "warn");
  }

  /** Ensure the picker dropdown shows + selects the given (saved) doc. */
  function syncPickerOption(doc: VoiceDoc): void {
    let opt = [...pickerSelect.options].find((o) => o.value === doc.id);
    if (!opt) {
      opt = document.createElement("option");
      opt.value = doc.id;
      pickerSelect.appendChild(opt);
    }
    opt.textContent = doc.id.startsWith(SAMPLE_ID_PREFIX)
      ? `${doc.client_name} — sample`
      : doc.client_name;
    pickerSelect.value = doc.id;
  }

  // Order-stable JSON so a doc loaded from storage (e.g. a sample seeded in
  // fixture key-order) doesn't read as "changed" against the form's
  // reconstructed key-order. Array order is preserved (reordering items IS a
  // real edit); only object keys are sorted.
  function stableStringify(value: unknown): string {
    if (Array.isArray(value)) return `[${value.map(stableStringify).join(",")}]`;
    if (value && typeof value === "object") {
      const obj = value as Record<string, unknown>;
      return `{${Object.keys(obj)
        .sort()
        .map((k) => `${JSON.stringify(k)}:${stableStringify(obj[k])}`)
        .join(",")}}`;
    }
    return JSON.stringify(value);
  }

  // Compare docs by CONTENT only. saveDoc() stamps a fresh `updated_at` on every
  // write, and readDoc() never produces one — so a raw stringify of the stored
  // doc vs. the form's doc would ALWAYS differ, making every doc read as "dirty"
  // (spurious autosaves on load, and a dropdown switch that clobbers itself).
  // Strip the volatile metadata before comparing.
  function contentKey(doc: VoiceDoc): string {
    const { updated_at, id, ...content } = doc as VoiceDoc & Record<string, unknown>;
    return stableStringify(content);
  }

  function scheduleAutosave(): void {
    if (mode !== "editing") return;
    const doc = form.readDoc();
    if (!doc.client_name.trim()) {
      if (docHasContent(doc)) setSaveStatus("needs-name");
      return;
    }
    const stored = getDoc(doc.id);
    if (stored && contentKey(stored) === contentKey(doc)) return; // unchanged
    setSaveStatus("saving");
    window.clearTimeout(autosaveTimer);
    autosaveTimer = window.setTimeout(flushAutosave, 700);
  }

  /** Persist pending edits immediately. Safe to call on transitions/unload. */
  function flushAutosave(): void {
    window.clearTimeout(autosaveTimer);
    if (mode !== "editing") return;
    const doc = form.readDoc();
    if (!doc.client_name.trim()) {
      if (docHasContent(doc)) setSaveStatus("needs-name");
      return;
    }
    const stored = getDoc(doc.id);
    if (stored && contentKey(stored) === contentKey(doc)) {
      setSaveStatus("saved");
      return;
    }
    const saved = saveDoc(doc);
    currentDoc = saved;
    syncPickerOption(saved);
    setSaveStatus("saved");
  }

  // The "Try a sample" + "Import a doc" rows are starting-point affordances —
  // only relevant while the current doc is still blank. Once it has content
  // (an existing client, an import, or a doc you've begun filling in), they're
  // clutter and a footgun, so hide them. Switching docs lives in the dropdown.
  // (In import-only mode the doc is blank, so the upload stays visible — which
  // is correct; the samples row is hidden there by the import-only CSS anyway.)
  function updateStartingPointsVisibility(): void {
    const fresh = !docHasContent(currentDoc);
    if (samplesDetails) samplesDetails.hidden = !fresh;
    if (uploadDetails) uploadDetails.hidden = !fresh;
  }

  // ─── Strength meter + summary rendering ──────────────────────────────
  function updateStrengthMeter(): void {
    const strength = computeDocStrength(currentDoc);
    strengthScore.textContent = String(strength.score);
    strengthSummary.textContent = strength.summary;
    strengthBox.dataset.band = bandLabelFor(strength.score);
    updateSubmitEnabled();
  }

  function renderSummary(): void {
    const strength = computeDocStrength(currentDoc);
    summaryClient.textContent = currentDoc.client_name || "(untitled doc)";
    summaryVertical.textContent = currentDoc.vertical || "";
    summaryScore.textContent = String(strength.score);
    summaryRoot.dataset.band = bandLabelFor(strength.score);
    const tones = currentDoc.tone_words.filter((t) => t.trim()).join(" · ");
    summaryTone.textContent = tones || "(no tone words set)";
    summaryStats.textContent = [
      `${currentDoc.banned_words.length} banned words`,
      `${currentDoc.voice_on_examples.length} voice-on examples`,
      `${currentDoc.voice_off_examples.length} voice-off examples`,
      `${currentDoc.examples_gallery.length} gallery entries`,
    ].join(" · ");
  }

  function bandLabelFor(score: number): string {
    if (score >= 9) return "strong";
    if (score >= 7) return "solid";
    if (score >= 5) return "workable";
    return "weak";
  }

  // ─── Picker + summary-switcher option lists ──────────────────────────
  function populatePickerSelect(): void {
    const docs = listDocs();
    pickerSelect.innerHTML = "";
    if (docs.length === 0) {
      const opt = document.createElement("option");
      opt.value = "";
      opt.textContent = "(no saved docs yet)";
      pickerSelect.appendChild(opt);
      return;
    }
    for (const d of docs) {
      const opt = document.createElement("option");
      opt.value = d.id;
      const isSample = d.id.startsWith(SAMPLE_ID_PREFIX);
      opt.textContent = isSample ? `${d.client_name} — sample` : d.client_name;
      pickerSelect.appendChild(opt);
    }
  }
  function populateSummarySwitcher(): void {
    const docs = listDocs();
    summarySwitcher.innerHTML = "";
    if (docs.length === 0) {
      const opt = document.createElement("option");
      opt.value = "";
      opt.textContent = "(no saved docs)";
      summarySwitcher.appendChild(opt);
      return;
    }
    for (const d of docs) {
      const opt = document.createElement("option");
      opt.value = d.id;
      const isSample = d.id.startsWith(SAMPLE_ID_PREFIX);
      opt.textContent = isSample ? `${d.client_name} — sample` : d.client_name;
      summarySwitcher.appendChild(opt);
    }
  }

  // ─── Upload + critique ───────────────────────────────────────────────
  if (uploadDrop && uploadInput) {
    ["dragenter", "dragover"].forEach((evt) => {
      uploadDrop.addEventListener(evt, (e) => {
        e.preventDefault();
        uploadDrop.dataset.drag = "over";
      });
    });
    ["dragleave", "drop"].forEach((evt) => {
      uploadDrop.addEventListener(evt, (e) => {
        e.preventDefault();
        delete uploadDrop.dataset.drag;
      });
    });
    uploadDrop.addEventListener("drop", (e) => {
      const dt = (e as DragEvent).dataTransfer;
      const f = dt?.files?.[0];
      if (f) void handleUpload(f);
    });
    uploadInput.addEventListener("change", () => {
      const f = uploadInput.files?.[0];
      if (f) void handleUpload(f);
    });
    // Click-to-browse: the transparent <input> overlays the drop area, but in
    // some browsers the centered hint text intercepts the click before it
    // reaches the input, so the file picker never opens (drag-drop still
    // works). Forward any click that didn't land on the input itself to the
    // input — this preserves the user gesture so the native dialog opens.
    uploadDrop.addEventListener("click", (e) => {
      if (e.target !== uploadInput) uploadInput.click();
    });
  }

  async function handleUpload(file: File): Promise<void> {
    if (!uploadDrop || !uploadStatus) return;
    uploadDrop.dataset.state = "busy";
    uploadStatus.dataset.state = "";
    uploadStatus.textContent = `Reading ${file.name}…`;
    try {
      const body = new FormData();
      body.append("file", file);
      uploadStatus.textContent = "Extracting structure and analyzing…";
      const res = await fetch("/api/import-doc", { method: "POST", body });
      const payload = (await res.json()) as ApiResponse<ImportResult>;
      if (!payload.ok) {
        uploadStatus.dataset.state = "error";
        uploadStatus.textContent = payload.message;
        delete uploadDrop.dataset.state;
        return;
      }
      uploadStatus.dataset.state = "success";
      uploadStatus.textContent = payload.data.cached
        ? "Re-imported from cache (identical to a previous upload)."
        : `Imported ${payload.data.filename}. Saved automatically — review the suggestions below.`;
      delete uploadDrop.dataset.state;
      applyImport(payload.data);
    } catch (err) {
      uploadStatus.dataset.state = "error";
      uploadStatus.textContent = "Upload failed. Try again.";
      delete uploadDrop.dataset.state;
    }
  }

  function applyImport(result: ImportResult): void {
    currentDoc = result.doc;
    form.setDoc(result.doc);
    updateStrengthMeter();
    renderCritique(result);
    syncBreakdownBtn(false);
    // Persist suggestions so the critique panel survives page refresh.
    // We store suggestions + stated_sections; strength is always recomputed
    // fresh from the current doc state so it stays accurate after edits.
    saveImportCritique(result.doc.id, result.suggestions ?? [], result.stated_sections ?? []);
    // Reveal the full editing view (form, picker, samples) now that there's
    // something to review — import-only mode is no longer appropriate.
    exitImportOnlyMode();
    // The imported doc has a name, so persist it right away and reflect it in
    // the picker (flushAutosave → syncPickerOption). Auto-save then keeps it in
    // sync as the user reviews and applies suggestions.
    flushAutosave();
    setPickerStatus(
      `Imported "${result.doc.client_name}" from ${result.filename}. Saved automatically — review and tweak below.`,
      "saved"
    );
    if (uploadDetails) uploadDetails.open = false;
    if (critiquePanel) critiquePanel.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  /**
   * If the given doc has stored import suggestions, rebuild the critique panel
   * using those suggestions and a freshly-computed strength score. If not,
   * hide the panel — prevents stale suggestions from a different doc leaking
   * through when the user switches docs or re-enters editing mode.
   */
  function maybeRestoreCritique(doc: VoiceDoc): void {
    if (!critiquePanel) return;
    const stored = loadImportCritique(doc.id);
    if (stored && stored.suggestions.length > 0) {
      renderCritique({
        doc,
        filename: "",
        format: "text",
        cached: false,
        sections_detected: 0,
        strength: computeDocStrength(doc),
        suggestions: stored.suggestions,
        stated_sections: stored.stated_sections,
      });
      syncBreakdownBtn(false);
    } else {
      // No stored critique — ensure any previously-rendered panel is hidden
      // so we don't show another doc's suggestions by mistake.
      critiquePanel.hidden = true;
      syncBreakdownBtn(true);
    }
  }

  /**
   * Always shows the critique panel — recomputes strength fresh and uses
   * stored import suggestions if available. Used by the strength box toggle
   * so the panel opens even for docs that were never imported.
   */
  function showStrengthPanel(doc: VoiceDoc): void {
    if (!critiquePanel) return;
    const stored = loadImportCritique(doc.id);
    renderCritique({
      doc,
      filename: "",
      format: "text",
      cached: false,
      sections_detected: 0,
      strength: computeDocStrength(doc),
      suggestions: stored?.suggestions ?? [],
      stated_sections: stored?.stated_sections ?? [],
    });
  }

  /** Keep the breakdown button label in sync with panel visibility. */
  function syncBreakdownBtn(panelHidden: boolean): void {
    if (!strengthBreakdownBtn) return;
    strengthBreakdownBtn.textContent = panelHidden
      ? "See section breakdown →"
      : "Hide breakdown ↑";
  }

  // ─── Strength box click — toggle the critique panel ──────────────────
  strengthBox.addEventListener("click", () => {
    if (!critiquePanel) return;
    if (critiquePanel.hidden) {
      showStrengthPanel(currentDoc);
      syncBreakdownBtn(false);
      critiquePanel.scrollIntoView({ behavior: "smooth", block: "start" });
    } else {
      critiquePanel.hidden = true;
      syncBreakdownBtn(true);
    }
  });

  const SECTION_LABELS: Record<number, string> = {
    1: "Tone words",
    2: "Banned words",
    3: "Cadence rules",
    4: "Voice-on examples",
    5: "Voice-off examples",
    6: "Punctuation",
    7: "CTA rules",
    8: "Terminology",
    9: "Exceptions",
    10: "Examples gallery",
  };

  // Sections whose suggestion items map cleanly onto a voice-doc field, so the
  // "Apply" button can actually insert them. Other sections (e.g. 6 punctuation,
  // 9 exceptions) produce advisory prose with no structured target — for those
  // we show the suggestion text but no Apply button, so it can't silently no-op.
  // Keep in lockstep with the switch in applySuggestion().
  const APPLIABLE_SECTIONS = new Set([2, 3, 4, 5, 7, 8, 10]);

  /**
   * Render suggestion example items as readable, structured DOM — never raw
   * JSON. Item shape is detected by its keys so the renderer is robust to which
   * section produced it:
   *   string                       → a plain quoted line (cadence/voice-on/gallery)
   *   { example, why_wrong }       → voice-off: the off-brand line + why it fails
   *   { use, not, note? }          → terminology: use X, not Y
   *   { word, reason? }            → banned word + reason
   *   { preferred, banned, tone }  → CTA rules: preferred/avoid phrase chips + tone
   */
  /**
   * @param onApplyItem - When provided, each item renders a small "Add" button
   *   that applies only that one item. Pass null/undefined to omit per-item buttons.
   */
  function buildExampleList(
    items: Array<string | object>,
    onApplyItem?: (item: string | object) => void
  ): HTMLUListElement {
    const wrap = document.createElement("ul");
    wrap.className = "critique__suggestion-examples";

    for (const item of items) {
      const li = document.createElement("li");
      li.className = "critique__ex";

      if (typeof item === "string") {
        li.classList.add("critique__ex--quote");
        li.textContent = item;
      } else {
        const obj = item as Record<string, any>;
        if ("example" in obj) {
          li.classList.add("critique__ex--voiceoff");
          const quote = document.createElement("span");
          quote.className = "critique__ex-quote";
          quote.textContent = obj.example;
          li.appendChild(quote);
          if (obj.why_wrong) {
            const why = document.createElement("span");
            why.className = "critique__ex-why";
            why.textContent = obj.why_wrong;
            li.appendChild(why);
          }
        } else if ("use" in obj && "not" in obj) {
          li.classList.add("critique__ex--term");
          const use = document.createElement("strong");
          use.textContent = obj.use;
          const not = document.createElement("span");
          not.className = "critique__ex-strike";
          not.textContent = obj.not;
          li.append("Use ", use, ", not ", not);
          if (obj.note) {
            const note = document.createElement("span");
            note.className = "critique__ex-note";
            note.textContent = ` (${obj.note})`;
            li.appendChild(note);
          }
        } else if ("word" in obj) {
          li.classList.add("critique__ex--term");
          const word = document.createElement("strong");
          word.textContent = obj.word;
          li.appendChild(word);
          if (obj.reason) {
            const reason = document.createElement("span");
            reason.className = "critique__ex-note";
            reason.textContent = ` — ${obj.reason}`;
            li.appendChild(reason);
          }
        } else if ("preferred" in obj || "banned" in obj || "tone" in obj) {
          li.classList.add("critique__ex--cta");
          // Normalise: AI sometimes returns a plain string instead of string[].
          const toArr = (v: unknown): unknown[] =>
            Array.isArray(v) ? v : typeof v === "string" && v.trim() ? [v] : [];
          const group = (label: string, arr: unknown, variant: string) => {
            const items = toArr(arr);
            if (items.length === 0) return;
            const g = document.createElement("div");
            g.className = "critique__cta-group";
            const lab = document.createElement("span");
            lab.className = "critique__cta-label";
            lab.textContent = label;
            g.appendChild(lab);
            for (const phrase of items) {
              const chip = document.createElement("span");
              chip.className = `critique__chip critique__chip--${variant}`;
              chip.textContent = String(phrase);
              g.appendChild(chip);
            }
            li.appendChild(g);
          };
          group("Preferred", obj.preferred, "ok");
          group("Avoid", obj.banned, "bad");
          if (obj.tone) {
            const tone = document.createElement("div");
            tone.className = "critique__cta-tone";
            tone.textContent = obj.tone;
            li.appendChild(tone);
          }
        } else {
          // Unknown shape — show its string values readably rather than JSON.
          li.textContent = Object.values(obj)
            .filter((v) => typeof v === "string")
            .join(" — ");
        }
      }
      // Per-item Add button — only when the caller supplies a handler.
      if (onApplyItem) {
        const addBtn = document.createElement("button");
        addBtn.type = "button";
        addBtn.className = "btn btn--ghost critique__ex-add";
        addBtn.dataset.itemAdd = "";
        addBtn.textContent = "Add";
        addBtn.addEventListener("click", () => {
          onApplyItem(item);
          addBtn.textContent = "Added";
          addBtn.disabled = true;
        });
        li.appendChild(addBtn);
      }
      wrap.appendChild(li);
    }
    return wrap;
  }

  function renderCritique(result: ImportResult): void {
    if (!critiquePanel) return;
    critiquePanel.hidden = false;
    const scoreEl = critiquePanel.querySelector('[data-field="critique_score"]') as HTMLElement;
    const summaryEl = critiquePanel.querySelector('[data-field="critique_summary"]') as HTMLElement;
    scoreEl.textContent = String(result.strength.score);
    summaryEl.textContent = result.strength.summary;
    critiquePanel.dataset.band = bandLabelFor(result.strength.score);

    const sectionsList = critiquePanel.querySelector('[data-field="critique_sections"]') as HTMLElement;
    sectionsList.innerHTML = "";
    const statedSet = new Set(result.stated_sections ?? []);
    for (const s of result.strength.sections) {
      const li = document.createElement("li");
      const pill = document.createElement("span");
      pill.className = "critique__pill";
      pill.dataset.status = s.status;
      pill.textContent = s.status;
      const text = document.createElement("span");
      text.className = "critique__section-text";
      const name = document.createElement("span");
      name.className = "critique__section-name";
      name.textContent = SECTION_LABELS[s.section] ?? s.label;
      const reason = document.createElement("span");
      reason.className = "critique__section-reason";
      reason.textContent = s.reason;
      text.appendChild(name);
      text.appendChild(reason);
      // Only show an origin badge when something is present — "missing" sections
      // came from neither source, so labeling them is noise.
      if (s.status !== "missing") {
        const origin = document.createElement("span");
        origin.className = "critique__origin";
        const fromDoc = statedSet.has(s.section);
        origin.dataset.origin = fromDoc ? "extracted" : "filled";
        origin.textContent = fromDoc ? "from your doc" : "we filled this in";
        text.appendChild(origin);
      }
      li.appendChild(pill);
      li.appendChild(text);
      sectionsList.appendChild(li);
    }

    const sugList = critiquePanel.querySelector('[data-field="critique_suggestions"]') as HTMLElement;
    const sugEmpty = critiquePanel.querySelector('[data-field="critique_no_suggestions"]') as HTMLElement;
    sugList.innerHTML = "";

    /** Helper: build and append one suggestion card to sugList. */
    const appendSugCard = (
      sectionNum: number,
      sectionLabel: string,
      bodyText: string,
      exampleItems?: Array<string | object>
    ) => {
      const li = document.createElement("li");
      const head = document.createElement("div");
      head.className = "critique__suggestion-head";
      const sectionSpan = document.createElement("span");
      sectionSpan.className = "critique__suggestion-section";
      sectionSpan.textContent = SECTION_LABELS[sectionNum] ?? sectionLabel;
      head.appendChild(sectionSpan);

      const hasAppliable = Array.isArray(exampleItems) &&
        exampleItems.length > 0 &&
        APPLIABLE_SECTIONS.has(sectionNum);

      let applyAllBtn: HTMLButtonElement | null = null;
      let exList: HTMLUListElement | null = null;

      if (hasAppliable) {
        applyAllBtn = document.createElement("button");
        applyAllBtn.type = "button";
        applyAllBtn.className = "btn btn--ghost btn--small";
        applyAllBtn.textContent = "Apply all →";
        head.appendChild(applyAllBtn);
      }

      const text = document.createElement("p");
      text.className = "critique__suggestion-text";
      text.textContent = bodyText;
      li.appendChild(head);
      li.appendChild(text);

      if (Array.isArray(exampleItems) && exampleItems.length > 0) {
        const sugObj = { section: sectionNum, section_label: sectionLabel,
          suggestion: bodyText, example_items: exampleItems };

        // Granular per-item Apply — tracks how many items have been applied
        // individually so the Apply all button can auto-disable when all are done.
        let appliedItemCount = 0;
        const onApplyItem = hasAppliable ? (item: string | object) => {
          applySuggestion({ ...sugObj, example_items: [item] });
          appliedItemCount++;
          if (applyAllBtn && appliedItemCount === exampleItems.length) {
            applyAllBtn.textContent = "Applied";
            applyAllBtn.disabled = true;
          }
        } : undefined;

        exList = buildExampleList(exampleItems, onApplyItem);
        li.appendChild(exList);

        if (applyAllBtn) {
          applyAllBtn.addEventListener("click", () => {
            applySuggestion(sugObj);
            applyAllBtn!.textContent = "Applied";
            applyAllBtn!.disabled = true;
            exList?.querySelectorAll<HTMLButtonElement>("[data-item-add]").forEach((b) => {
              b.textContent = "Added";
              b.disabled = true;
            });
          });
        }
      }

      sugList.appendChild(li);
    };

    // Render LLM-generated suggestions.
    for (const sug of result.suggestions ?? []) {
      appendSugCard(sug.section, sug.section_label, sug.suggestion, sug.example_items);
    }

    // Inject deterministic fallback advisory cards for any weak/missing sections
    // that the LLM didn't generate a suggestion for. The strength checker knows
    // exactly which sections are light — the LLM may just have skipped them.
    const coveredSections = new Set((result.suggestions ?? []).map((s) => s.section));
    const clientName = currentDoc.client_name || "this client";
    const FALLBACK_GUIDANCE: Partial<Record<number, string>> = {
      2: "Add at least 5 specific words or phrases to the Banned Words section to enable deterministic vocabulary checks.",
      3: "Add at least 2 explicit rules about sentence structure, length, or rhythm to the Cadence Rules section.",
      4: `Pull 2–3 real on-brand captions or headlines from ${clientName}'s published content and paste them into Voice-on Examples. Actual published copy is far more reliable than describing the voice in prose.`,
      5: "Add 2–3 examples of copy that sounds wrong for this brand, each with a short note on why it misses the mark. Voice-off examples are the strongest way to anchor off-brand tone for the scoring LLM.",
      7: "Add at least a preferred CTA phrase and one to avoid in the CTA Rules section to give the LLM an anchor for ask-tone.",
      8: "Add industry-specific term swaps — words where one version is correct and another isn't — to the Terminology section.",
      10: `Pull 5+ real published captions, headlines, or posts from ${clientName}'s feed and add them to the Examples Gallery. Gallery examples carry 2 of the 10 strength points — the single biggest contributor to the score after banned words and voice-on examples.`,
    };
    for (const s of result.strength.sections) {
      if (s.status === "present") continue;
      if (coveredSections.has(s.section)) continue;
      const guidance = FALLBACK_GUIDANCE[s.section];
      if (!guidance) continue;
      appendSugCard(s.section, s.label, `${s.reason} ${guidance}`);
    }

    // Show or hide the "no suggestions" empty state.
    const hasSuggestions = sugList.children.length > 0;
    sugList.hidden = !hasSuggestions;
    sugEmpty.hidden = hasSuggestions;
  }

  function applySuggestion(sug: ImportResult["suggestions"][number]): void {
    const doc = form.readDoc();
    const items = sug.example_items ?? [];
    switch (sug.section) {
      case 2:
        for (const it of items) {
          if (typeof it === "string") doc.banned_words.push({ word: it });
          else if (typeof it === "object" && "word" in (it as any))
            doc.banned_words.push(it as { word: string; reason?: string });
        }
        break;
      case 3:
        for (const it of items) {
          if (typeof it === "string") doc.cadence_rules.push(it);
        }
        break;
      case 4:
        for (const it of items) {
          if (typeof it === "string") doc.voice_on_examples.push(it);
        }
        break;
      case 5:
        for (const it of items) {
          if (typeof it === "object" && "example" in (it as any)) {
            doc.voice_off_examples.push(it as { example: string; why_wrong: string });
          }
        }
        break;
      case 7:
        for (const it of items) {
          if (typeof it !== "object" || !it) continue;
          const c = it as { preferred?: unknown; banned?: unknown; tone?: string };
          const strToArr = (v: unknown): string[] =>
            Array.isArray(v) ? (v as string[]) : typeof v === "string" && v.trim() ? [v] : [];
          const pref = strToArr(c.preferred);
          const banned = strToArr(c.banned);
          if (pref.length) doc.cta.preferred = pref;
          if (banned.length) doc.cta.banned = banned;
          if (typeof c.tone === "string") doc.cta.tone = c.tone;
        }
        break;
      case 8:
        for (const it of items) {
          if (typeof it === "object" && "use" in (it as any) && "not" in (it as any)) {
            doc.required_terms.push(it as { use: string; not: string; note?: string });
          }
        }
        break;
      case 10:
        for (const it of items) {
          if (typeof it === "string") doc.examples_gallery.push(it);
        }
        break;
    }
    form.setDoc(doc);
    currentDoc = doc;
    updateStrengthMeter();
  }

  const critiqueCloseBtn = editingView.querySelector('[data-critique-close]') as HTMLButtonElement | null;
  if (critiqueCloseBtn && critiquePanel) {
    critiqueCloseBtn.addEventListener("click", () => {
      critiquePanel.hidden = true;
      syncBreakdownBtn(true);
      // Clear persisted suggestions — the user has seen and dismissed the panel.
      clearImportCritique(currentDoc.id);
    });
  }

  // ─── Submit: score the draft against the current doc ────────────────
  submitBtn.addEventListener("click", async () => {
    const doc = currentDoc;
    const draft = draftInput.value.trim();
    if (!draft) {
      draftInput.focus();
      return;
    }
    if (!doc.client_name.trim() || doc.banned_words.length + doc.voice_on_examples.length === 0) {
      if (hint) hint.textContent = "Voice doc is too thin to score. Edit it and add banned words + voice-on examples first.";
      return;
    }

    submitBtn.disabled = true;
    if (hint) hint.textContent = "";
    if (wall) wall.hidden = true;
    if (loading) {
      loading.hidden = false;
      loading.dataset.stage = "reading";
    }
    const t1 = window.setTimeout(() => {
      if (loading) loading.dataset.stage = "extracting";
    }, 800);

    try {
      const res = await fetch("/api/check", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ voiceDoc: doc, draft }),
      });
      const payload = (await res.json()) as ApiResponse<VoiceResult>;
      window.clearTimeout(t1);

      if (!payload.ok) {
        if (payload.error === "rate_limit_exceeded" && wall) {
          wall.hidden = false;
          wall.scrollIntoView({ behavior: "smooth", block: "start" });
        } else if (hint) {
          hint.textContent = payload.message;
        }
        return;
      }

      if (loading) loading.dataset.stage = "done";
      (window as any).__lastResult = payload.data;
      render(payload.data, draft);
      // remaining === -1 is the unlimited sentinel from the API (DEMO_MODE
       // is off — buyer's fork or local dev). Suppress the hint entirely.
      if (hint && Number.isFinite(payload.remaining) && payload.remaining >= 0) {
        hint.textContent =
          payload.remaining > 0
            ? `${payload.remaining} demo run${payload.remaining === 1 ? "" : "s"} remaining`
            : "Last demo run used — fork to keep going.";
      } else if (hint) {
        hint.textContent = "";
      }
    } catch {
      if (hint) hint.textContent = "Network error. Try again.";
    } finally {
      updateSubmitEnabled();
      window.setTimeout(() => {
        if (loading) loading.hidden = true;
      }, 600);
    }
  });

  // Copy actions on the result panel.
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const data = (window as any).__lastResult as VoiceResult | undefined;
      if (!data) return;
      const text =
        btn.dataset.copy === "rewrite" ? data.rewritten_draft : formatFlags(data);
      navigator.clipboard.writeText(text);
      const orig = btn.textContent;
      btn.textContent = "Copied!";
      setTimeout(() => (btn.textContent = orig), 1400);
    });
  });

  function render(data: VoiceResult, originalDraft: string) {
    if (!resultPanel || !resultStage) return;
    resultStage.hidden = false;
    resultPanel.hidden = false;

    const bandEl = resultPanel.querySelector(".band") as HTMLElement;
    const bandLabel = resultPanel.querySelector('[data-field="band_label"]') as HTMLElement;
    const compositeEl = resultPanel.querySelector('[data-field="composite_score"]') as HTMLElement;
    const confidenceEl = resultPanel.querySelector('[data-field="confidence_badge"]') as HTMLElement;
    const reason = resultPanel.querySelector('[data-field="score_reason"]') as HTMLElement;

    bandEl.dataset.band = data.band;
    bandLabel.textContent = data.band_label;
    compositeEl.textContent = String(data.composite_score);
    if (data.confidence === "high") {
      confidenceEl.hidden = true;
    } else {
      confidenceEl.hidden = false;
      confidenceEl.dataset.confidence = data.confidence;
      confidenceEl.textContent =
        data.confidence === "medium" ? "Medium confidence" : "Low confidence";
    }
    reason.textContent = data.score_reason;

    renderSubScores(data);

    const draftEl = resultPanel.querySelector('[data-field="highlightedDraft"]') as HTMLElement;
    draftEl.innerHTML = highlight(originalDraft, data.flags.map((f) => f.phrase));

    const flagsList = resultPanel.querySelector('[data-field="flags"]') as HTMLElement;
    const flagsEmpty = resultPanel.querySelector('[data-field="flagsEmpty"]') as HTMLElement;
    flagsList.innerHTML = "";
    if (data.flags.length === 0) {
      flagsEmpty.hidden = false;
    } else {
      flagsEmpty.hidden = true;
      data.flags.forEach((f) => {
        const li = document.createElement("li");
        const badge = document.createElement("span");
        badge.className = "flag__badge";
        badge.textContent = categoryLabel(f.category);
        const phrase = document.createElement("p");
        phrase.className = "flag__phrase";
        phrase.textContent = f.phrase;
        li.appendChild(badge);
        li.appendChild(phrase);
        if (f.rule_cited) {
          const rule = document.createElement("p");
          rule.className = "flag__rule";
          rule.textContent = f.rule_cited;
          li.appendChild(rule);
        }
        if (f.suggested_rewrite) {
          const rewrite = document.createElement("p");
          rewrite.className = "flag__rewrite";
          const label = document.createElement("span");
          label.className = "flag__rewrite-label";
          label.textContent = "Try";
          const rewriteText = document.createElement("span");
          rewriteText.className = "flag__rewrite-text";
          rewriteText.textContent = f.suggested_rewrite;
          rewrite.appendChild(label);
          rewrite.appendChild(rewriteText);
          li.appendChild(rewrite);
        }
        flagsList.appendChild(li);
      });
    }

    const rewritten = resultPanel.querySelector('[data-field="rewritten_draft"]') as HTMLElement;
    rewritten.textContent = data.rewritten_draft;

    resultStage.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function renderSubScores(data: VoiceResult) {
    if (!resultPanel) return;
    const keys = ["vocabulary", "punctuation", "tone", "cadence"] as const;
    for (const key of keys) {
      const el = resultPanel.querySelector(`.subscore[data-key="${key}"]`) as HTMLElement | null;
      if (!el) continue;
      const value = data.sub_scores[key];
      const numEl = el.querySelector(".subscore__num") as HTMLElement;
      const fillEl = el.querySelector(".subscore__fill") as HTMLElement;
      numEl.textContent = String(value);
      fillEl.style.width = `${Math.max(0, Math.min(100, value))}%`;
      el.dataset.band = subBandFor(value);
    }
  }

  function subBandFor(score: number): string {
    if (score >= 90) return "on-brand";
    if (score >= 75) return "mostly-on-brand";
    if (score >= 55) return "drifting";
    if (score >= 35) return "off-brand";
    return "rewrite-needed";
  }

  function highlight(text: string, phrases: string[]): string {
    if (phrases.length === 0) return escapeHtml(text);
    const sorted = [...new Set(phrases)].sort((a, b) => b.length - a.length);
    let out = "";
    let cursor = 0;
    while (cursor < text.length) {
      let bestIdx = -1;
      let bestPhrase = "";
      for (const p of sorted) {
        if (!p) continue;
        const idx = text.indexOf(p, cursor);
        if (idx !== -1 && (bestIdx === -1 || idx < bestIdx)) {
          bestIdx = idx;
          bestPhrase = p;
        }
      }
      if (bestIdx === -1) {
        out += escapeHtml(text.slice(cursor));
        break;
      }
      out += escapeHtml(text.slice(cursor, bestIdx));
      out += `<mark>${escapeHtml(bestPhrase)}</mark>`;
      cursor = bestIdx + bestPhrase.length;
    }
    return out;
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function formatFlags(d: VoiceResult): string {
    const header = `${d.band_label} — ${d.composite_score}/100 (${d.confidence} confidence)`;
    const sub = `Sub-scores: vocabulary ${d.sub_scores.vocabulary} · punctuation ${d.sub_scores.punctuation} · tone ${d.sub_scores.tone} · cadence ${d.sub_scores.cadence}`;
    if (d.flags.length === 0) {
      return `${header}\n${sub}\n${d.score_reason}\nNo flags.`;
    }
    return [
      header,
      sub,
      d.score_reason,
      "",
      ...d.flags.map(
        (f, i) =>
          `${i + 1}. [${categoryLabel(f.category)}] "${f.phrase}"` +
          (f.rule_cited ? ` — ${f.rule_cited}` : "") +
          (f.suggested_rewrite ? `\n   Try: ${f.suggested_rewrite}` : "")
      ),
    ].join("\n");
  }

  /** Human-readable label for a flag's category badge. */
  function categoryLabel(category: VoiceFlagCategory): string {
    switch (category) {
      case "banned_word":
        return "Banned word";
      case "punctuation":
        return "Punctuation";
      case "terminology":
        return "Terminology";
      case "voice":
        return "Voice";
    }
  }
</script>
