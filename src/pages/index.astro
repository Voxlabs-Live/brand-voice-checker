---
import ToolLayout from "../layouts/ToolLayout.astro";
import LoadingStages from "../components/LoadingStages.astro";
import RateLimitWall from "../components/RateLimitWall.astro";
import VoiceResult from "../components/VoiceResult.astro";
import VoiceDocForm from "../components/VoiceDocForm.astro";
import VoiceDocPicker from "../components/VoiceDocPicker.astro";
import VoiceDocSummary from "../components/VoiceDocSummary.astro";
import UploadDoc from "../components/UploadDoc.astro";
import DocCritiquePanel from "../components/DocCritiquePanel.astro";

const REPO_URL = "https://github.com/Voxlabs-Live/brand-voice-checker";
---
<ToolLayout
  toolName="Brand Voice Checker"
  description="Build a structured voice doc per client, save it, and check drafts against it. Every flag comes with the cited rule, scored across vocabulary, punctuation, tone, and cadence. Part of the Agency Vibe-Coding Kit."
  repoUrl={REPO_URL}
>
  <h1 class="tool-title">
    Catch off-brand copy before it goes to the <em>client</em>.
  </h1>
  <p class="tool-lede">
    Build a voice doc for each client, then check drafts against it. Flags
    cite the specific rule each violation breaks.
  </p>

  <!-- ─── STAGE 01 — Voice doc ─────────────────────────────────────────── -->
  <section class="stage" data-stage="voice-doc" data-mode="empty">
    <header class="stage__head">
      <span class="stage__num">01</span>
      <h2 class="stage__title">Voice doc</h2>
      <span class="stage__status" data-stage-status>Pick how to start</span>
    </header>

    <!-- Empty state: no saved docs -->
    <div class="stage__body stage__body--empty" data-mode-view="empty">
      <p class="stage-empty__lead">
        Build a structured voice doc — the tool needs this to score drafts.
        Pick how you want to start:
      </p>
      <div class="stage-empty__actions">
        <button type="button" class="card-btn" data-empty-build>
          <span class="card-btn__title">Build from scratch</span>
          <span class="card-btn__desc">Walk through 10 sections in the form. Takes about 30 minutes with your client.</span>
        </button>
        <button type="button" class="card-btn" data-empty-import>
          <span class="card-btn__title">Import existing doc</span>
          <span class="card-btn__desc">Drop a PDF, Word, or Markdown doc. We'll extract what we can and critique the rest.</span>
        </button>
        <button type="button" class="card-btn" data-empty-sample>
          <span class="card-btn__title">Try a sample</span>
          <span class="card-btn__desc">Load Aurelia Lashes, Mantra Yoga, or Dr. Eckhardt Clinic to see scoring in action.</span>
        </button>
      </div>
      <div class="stage-empty__samples" data-empty-samples hidden>
        <p class="stage-empty__hint">Pick a sample:</p>
        <div class="samples" data-samples-row></div>
      </div>
    </div>

    <!-- Summary state: doc selected, not editing -->
    <div class="stage__body stage__body--summary" data-mode-view="summary" hidden>
      <VoiceDocSummary />
    </div>

    <!-- Editing state: full form + picker + upload + critique.
         When data-import-only="true", picker/samples/form are hidden so the
         user can focus on the upload drop area. Removed automatically after
         a successful import. -->
    <div class="stage__body stage__body--editing" data-mode-view="editing" hidden>
      <p class="import-only-lead" data-import-lead hidden>
        Drop your existing voice doc below. We'll extract the structured
        fields and show you what's missing — you'll review everything before
        anything saves.
      </p>
      <div data-editing-picker>
        <VoiceDocPicker />
        <details class="samples-details">
          <summary class="samples-details__summary">Try with a built-in sample →</summary>
          <div class="samples" data-samples-row-editing></div>
        </details>
      </div>
      <UploadDoc />
      <DocCritiquePanel />
      <div data-editing-form>
        <VoiceDocForm />
      </div>
      <p class="import-only-escape" data-import-escape hidden>
        Or <a href="#" data-import-switch-build>build from scratch instead →</a>
      </p>
      <div class="stage__footer">
        <button type="button" class="btn btn--ghost" data-editing-cancel>Cancel</button>
        <button type="button" class="btn btn--primary" data-editing-done>Done editing →</button>
      </div>
    </div>
  </section>

  <!-- ─── STAGE 02 — Draft ─────────────────────────────────────────────── -->
  <section class="stage" data-stage="draft">
    <header class="stage__head">
      <span class="stage__num">02</span>
      <h2 class="stage__title">Draft to check</h2>
      <span class="stage__status" data-draft-target></span>
    </header>
    <div class="stage__body">
      <label class="field-label visually-hidden" for="draft">Draft to check</label>
      <textarea
        class="input"
        id="draft"
        name="draft"
        placeholder="Paste the draft copy you want to check — caption, email, post, anything client-facing..."
        rows="6"
      ></textarea>
      <div class="actions">
        <button class="btn btn--primary" id="submit">Check voice fit &rarr;</button>
        <LoadingStages stages={["Reading", "Scoring", "Done"]} />
        <span class="actions__hint" id="hint"></span>
      </div>
    </div>
  </section>

  <!-- ─── STAGE 03 — Result (revealed after first submit) ──────────────── -->
  <section class="stage stage--result" data-stage="result" hidden>
    <header class="stage__head">
      <span class="stage__num">03</span>
      <h2 class="stage__title">Result</h2>
    </header>
    <div class="stage__body">
      <VoiceResult />
    </div>
  </section>

  <RateLimitWall repoUrl={REPO_URL} />
</ToolLayout>

<style>
  /* Stage layout — three vertical cards with numbered headers. */
  .stage {
    background: var(--surface-0);
    border: 1px solid var(--surface-200);
    border-radius: var(--radius-lg);
    margin-bottom: 1rem;
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .stage:last-of-type { margin-bottom: 0; }

  .stage__head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.9rem 1.5rem;
    border-bottom: 1px solid var(--surface-150);
    background: var(--surface-50);
  }
  .stage__num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--surface-500);
    letter-spacing: 0.05em;
  }
  .stage__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    margin: 0;
    color: var(--surface-900);
  }
  .stage__status {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--surface-600);
    text-align: right;
  }
  .stage__body {
    padding: 1.25rem 1.5rem 1.5rem;
  }
  .stage__body--empty,
  .stage__body--summary {
    padding: 1.25rem 1.5rem 1.5rem;
  }
  .stage__footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--surface-200);
  }

  /* Active stage gets a stronger left-edge treatment so the eye knows where
     to go without changing the overall card style. */
  .stage[data-active="true"] {
    border-color: var(--surface-300);
    box-shadow: var(--shadow-lg);
  }

  /* ─── Empty-state CTAs ──────────────────────────────────────────────── */
  .stage-empty__lead {
    margin: 0 0 1rem;
    color: var(--surface-700);
    font-size: var(--text-base);
  }
  .stage-empty__actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }
  @media (max-width: 760px) {
    .stage-empty__actions { grid-template-columns: 1fr; }
  }
  .card-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
    text-align: left;
    background: var(--surface-50);
    border: 1px solid var(--surface-200);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
    cursor: pointer;
    transition: border-color 0.12s, background 0.12s, transform 0.08s;
    font-family: inherit;
    color: inherit;
  }
  .card-btn:hover {
    border-color: var(--accent-400);
    background: oklch(from var(--accent-50) l c h / 0.6);
  }
  .card-btn:active { transform: translateY(1px); }
  .card-btn__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--font-weight-semibold);
    color: var(--surface-900);
  }
  .card-btn__desc {
    font-size: var(--text-sm);
    color: var(--surface-700);
    line-height: var(--leading-normal);
  }
  .stage-empty__samples {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--surface-200);
  }
  .stage-empty__hint {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--surface-600);
  }
  .samples {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  /* ─── Editing-mode trimmings ────────────────────────────────────────── */
  .samples-details {
    margin: 0.5rem 0 1rem;
  }
  .samples-details__summary {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--surface-700);
    cursor: pointer;
    padding: 0.4rem 0;
    list-style: none;
  }
  .samples-details__summary::-webkit-details-marker { display: none; }
  .samples-details[open] .samples-details__summary { margin-bottom: 0.5rem; }

  /* The form inside editing mode loses its own outer card chrome since the
     stage is already a card. */
  .stage__body--editing .voice-form {
    box-shadow: none;
    border-color: var(--surface-150);
  }

  /* ─── Import-only sub-state ────────────────────────────────────────────
     Triggered when user clicks "Import existing doc". Hides everything
     except the upload drop area so the focus is on the file. The form
     reveals once applyImport() completes. */
  .stage__body--editing[data-import-only="true"] [data-editing-picker],
  .stage__body--editing[data-import-only="true"] [data-editing-form],
  .stage__body--editing[data-import-only="true"] [data-editing-done] {
    display: none;
  }
  .import-only-lead {
    margin: 0 0 0.85rem;
    color: var(--surface-700);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
  }
  .import-only-escape {
    margin: 1rem 0 0;
    font-size: var(--text-sm);
    color: var(--surface-600);
    text-align: center;
  }
  .import-only-escape a {
    color: var(--accent-600);
    font-weight: var(--font-weight-semibold);
  }
  .import-only-escape a:hover { color: var(--accent-700); }

  /* In import-only mode, lift the upload area visually so the user knows
     it's the primary action. */
  .stage__body--editing[data-import-only="true"] .upload {
    border-color: var(--surface-300);
    background: var(--surface-0);
  }
  .stage__body--editing[data-import-only="true"] .upload__drop {
    padding: 2.5rem 1.5rem;
  }

  /* Visually hide a label but keep it for screen readers. */
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { VOICE_SAMPLES, SAMPLE_DOCS } from "../fixtures/studio-north";
  import {
    seedSamplesIfNeeded,
    listDocs,
    getDoc,
    saveDoc,
    deleteDoc,
    duplicateDoc,
    SAMPLE_ID_PREFIX,
  } from "../lib/voice-doc-storage";
  import {
    emptyVoiceDoc,
    type VoiceDoc,
  } from "../lib/voice-doc-schema";
  import { computeDocStrength } from "../lib/voice-doc-strength";
  import { mountForm, type FormHandle } from "../lib/voice-doc-form";
  import type { VoiceResult } from "../lib/voice-types";
  import type { ApiResponse } from "../lib/types";
  import type { ImportResult } from "./api/import-doc";

  type Mode = "empty" | "summary" | "editing";
  let mode: Mode = "empty";
  /** The doc the user is currently scoring against (and editing, in editing mode). */
  let currentDoc: VoiceDoc = emptyVoiceDoc();
  /** Snapshot used to detect unsaved changes when "Done editing" or "Cancel" is clicked. */
  let editingBaselineId = "";

  const $ = (sel: string) => document.querySelector(sel) as HTMLElement | null;
  const draftInput = $("#draft") as HTMLTextAreaElement;
  const submitBtn = $("#submit") as HTMLButtonElement;
  const hint = $("#hint");
  const loading = document.querySelector(".loading") as HTMLElement | null;
  const resultPanel = document.querySelector(".result") as HTMLElement | null;
  const resultStage = document.querySelector('[data-stage="result"]') as HTMLElement | null;
  const wall = document.querySelector(".wall") as HTMLElement | null;

  const stageVoiceDoc = document.querySelector('[data-stage="voice-doc"]') as HTMLElement;
  const stageStatus = stageVoiceDoc.querySelector('[data-stage-status]') as HTMLElement;
  const draftStatus = document.querySelector('[data-draft-target]') as HTMLElement;
  const emptyView = stageVoiceDoc.querySelector('[data-mode-view="empty"]') as HTMLElement;
  const summaryView = stageVoiceDoc.querySelector('[data-mode-view="summary"]') as HTMLElement;
  const editingView = stageVoiceDoc.querySelector('[data-mode-view="editing"]') as HTMLElement;

  // Empty-state controls.
  const emptyBuildBtn = stageVoiceDoc.querySelector('[data-empty-build]') as HTMLButtonElement;
  const emptyImportBtn = stageVoiceDoc.querySelector('[data-empty-import]') as HTMLButtonElement;
  const emptySampleBtn = stageVoiceDoc.querySelector('[data-empty-sample]') as HTMLButtonElement;
  const emptySamplesBox = stageVoiceDoc.querySelector('[data-empty-samples]') as HTMLElement;
  const emptySamplesRow = stageVoiceDoc.querySelector('[data-samples-row]') as HTMLElement;

  // Summary controls.
  const summaryRoot = summaryView.querySelector('[data-doc-summary]') as HTMLElement;
  const summaryClient = summaryRoot.querySelector('[data-summary-client]') as HTMLElement;
  const summaryVertical = summaryRoot.querySelector('[data-summary-vertical]') as HTMLElement;
  const summaryScore = summaryRoot.querySelector('[data-summary-score]') as HTMLElement;
  const summaryTone = summaryRoot.querySelector('[data-summary-tone]') as HTMLElement;
  const summaryStats = summaryRoot.querySelector('[data-summary-stats]') as HTMLElement;
  const summaryEditBtn = summaryRoot.querySelector('[data-summary-edit]') as HTMLButtonElement;
  const summarySwitcher = summaryRoot.querySelector('[data-summary-switcher]') as HTMLSelectElement;
  const summaryNewBtn = summaryRoot.querySelector('[data-summary-new]') as HTMLButtonElement;
  const summaryImportBtn = summaryRoot.querySelector('[data-summary-import]') as HTMLButtonElement;

  // Editing controls.
  const formRoot = editingView.querySelector('.voice-form') as HTMLElement;
  const pickerSelect = editingView.querySelector('[data-picker-select]') as HTMLSelectElement;
  const pickerStatus = editingView.querySelector('[data-picker-status]') as HTMLElement;
  const pickerNew = editingView.querySelector('[data-picker-new]') as HTMLButtonElement;
  const pickerDup = editingView.querySelector('[data-picker-duplicate]') as HTMLButtonElement;
  const pickerDel = editingView.querySelector('[data-picker-delete]') as HTMLButtonElement;
  const pickerSave = editingView.querySelector('[data-picker-save]') as HTMLButtonElement;
  const editingSamplesRow = editingView.querySelector('[data-samples-row-editing]') as HTMLElement;
  const strengthBox = formRoot.querySelector('[data-field="strength_meter"]') as HTMLElement;
  const strengthScore = formRoot.querySelector('[data-field="strength_score"]') as HTMLElement;
  const strengthSummary = formRoot.querySelector('[data-field="strength_summary"]') as HTMLElement;
  const doneEditingBtn = editingView.querySelector('[data-editing-done]') as HTMLButtonElement;
  const cancelEditingBtn = editingView.querySelector('[data-editing-cancel]') as HTMLButtonElement;
  const uploadDetails = editingView.querySelector('[data-upload]') as HTMLDetailsElement | null;
  const uploadDrop = editingView.querySelector('[data-upload-drop]') as HTMLElement | null;
  const uploadInput = editingView.querySelector('[data-upload-input]') as HTMLInputElement | null;
  const uploadStatus = editingView.querySelector('[data-upload-status]') as HTMLElement | null;
  const critiquePanel = editingView.querySelector('[data-critique]') as HTMLElement | null;

  const form: FormHandle = mountForm(formRoot);
  form.onChange((doc) => {
    currentDoc = doc;
    updateStrengthMeter();
  });

  // Bootstrap.
  seedSamplesIfNeeded(SAMPLE_DOCS);
  populateAllSamplesRows();
  populatePickerSelect();
  populateSummarySwitcher();
  initialMode();

  function initialMode(): void {
    const docs = listDocs();
    if (docs.length === 0) {
      setMode("empty");
    } else {
      currentDoc = docs[0];
      pickerSelect.value = currentDoc.id;
      form.setDoc(currentDoc);
      summarySwitcher.value = currentDoc.id;
      setMode("summary");
    }
  }

  function setMode(next: Mode): void {
    mode = next;
    stageVoiceDoc.dataset.mode = next;
    emptyView.hidden = next !== "empty";
    summaryView.hidden = next !== "summary";
    editingView.hidden = next !== "editing";
    stageVoiceDoc.dataset.active = next === "editing" ? "true" : "false";
    refreshStageStatus();
    refreshDraftTarget();
    updateSubmitEnabled();
    if (next === "summary") renderSummary();
  }

  function refreshStageStatus(): void {
    if (mode === "empty") {
      stageStatus.textContent = "Pick how to start";
    } else if (mode === "summary") {
      stageStatus.textContent = "Ready";
    } else {
      stageStatus.textContent = "Editing";
    }
  }

  function refreshDraftTarget(): void {
    if (mode === "summary" && currentDoc.client_name) {
      draftStatus.textContent = `Scoring against ${currentDoc.client_name}`;
    } else if (mode === "editing") {
      draftStatus.textContent = "Finish editing the voice doc first";
    } else {
      draftStatus.textContent = "No voice doc yet";
    }
  }

  function updateSubmitEnabled(): void {
    const docOk =
      currentDoc.client_name.trim() &&
      (currentDoc.banned_words.length > 0 ||
        currentDoc.voice_on_examples.length > 0);
    const draftOk = draftInput.value.trim().length > 0;
    const enabled = !!docOk && draftOk && mode !== "editing";
    submitBtn.disabled = !enabled;
  }
  draftInput.addEventListener("input", updateSubmitEnabled);

  // ─── Sample buttons (empty state + editing mode) ────────────────────
  function populateAllSamplesRows(): void {
    for (const row of [emptySamplesRow, editingSamplesRow]) {
      if (!row) continue;
      row.innerHTML = "";
      for (const s of VOICE_SAMPLES) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "btn btn--ghost btn--small";
        btn.textContent = s.client;
        btn.addEventListener("click", () => {
          // Make sure the sample doc is saved (it should be from seedSamples,
          // but the on-brand control shares Aurelia's id so we re-resolve).
          const sourceId = s.voiceDoc.id;
          let saved = getDoc(sourceId);
          if (!saved) saved = saveDoc(s.voiceDoc);
          currentDoc = saved;
          form.setDoc(saved);
          draftInput.value = s.draft;
          populatePickerSelect();
          populateSummarySwitcher();
          pickerSelect.value = saved.id;
          summarySwitcher.value = saved.id;
          setMode("summary");
          updateStrengthMeter();
          updateSubmitEnabled();
        });
        row.appendChild(btn);
      }
    }
  }

  // ─── Empty-state actions ─────────────────────────────────────────────
  emptyBuildBtn.addEventListener("click", () => {
    currentDoc = emptyVoiceDoc();
    form.setDoc(currentDoc);
    editingBaselineId = "";
    if (uploadDetails) uploadDetails.open = false;
    exitImportOnlyMode();
    setMode("editing");
    setPickerStatus("New blank doc — fill in the form, then click Save changes.", "warn");
  });
  emptyImportBtn.addEventListener("click", () => {
    currentDoc = emptyVoiceDoc();
    form.setDoc(currentDoc);
    editingBaselineId = "";
    enterImportOnlyMode();
  });
  emptySampleBtn.addEventListener("click", () => {
    emptySamplesBox.hidden = false;
    emptySamplesBox.scrollIntoView({ behavior: "smooth", block: "center" });
  });

  // ─── Summary actions ─────────────────────────────────────────────────
  summaryEditBtn.addEventListener("click", () => {
    editingBaselineId = currentDoc.id;
    pickerSelect.value = currentDoc.id;
    form.setDoc(currentDoc);
    exitImportOnlyMode();
    setMode("editing");
    setPickerStatus("");
  });
  summarySwitcher.addEventListener("change", () => {
    const doc = getDoc(summarySwitcher.value);
    if (doc) {
      currentDoc = doc;
      pickerSelect.value = doc.id;
      form.setDoc(doc);
      setMode("summary");
    }
  });
  summaryNewBtn.addEventListener("click", () => {
    currentDoc = emptyVoiceDoc();
    form.setDoc(currentDoc);
    editingBaselineId = "";
    if (uploadDetails) uploadDetails.open = false;
    exitImportOnlyMode();
    setMode("editing");
    setPickerStatus("New blank doc — fill in the form, then click Save changes.", "warn");
  });
  summaryImportBtn.addEventListener("click", () => {
    currentDoc = emptyVoiceDoc();
    form.setDoc(currentDoc);
    editingBaselineId = "";
    enterImportOnlyMode();
  });

  /** Switch to editing mode with everything except the upload drop area
      hidden, so the user can focus on the file drop. Cleared after a
      successful import or when the user clicks Cancel / build-from-scratch. */
  function enterImportOnlyMode(): void {
    if (uploadDetails) uploadDetails.open = true;
    setMode("editing");
    editingView.dataset.importOnly = "true";
    const lead = editingView.querySelector('[data-import-lead]') as HTMLElement;
    const escape = editingView.querySelector('[data-import-escape]') as HTMLElement;
    if (lead) lead.hidden = false;
    if (escape) escape.hidden = false;
    setPickerStatus("");
    editingView.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function exitImportOnlyMode(): void {
    delete editingView.dataset.importOnly;
    const lead = editingView.querySelector('[data-import-lead]') as HTMLElement;
    const escape = editingView.querySelector('[data-import-escape]') as HTMLElement;
    if (lead) lead.hidden = true;
    if (escape) escape.hidden = true;
  }

  // "Build from scratch instead" escape link inside the import-only view.
  const importSwitchBuild = editingView.querySelector('[data-import-switch-build]') as HTMLAnchorElement | null;
  if (importSwitchBuild) {
    importSwitchBuild.addEventListener("click", (e) => {
      e.preventDefault();
      exitImportOnlyMode();
      if (uploadDetails) uploadDetails.open = false;
      setPickerStatus("New blank doc — fill in the form, then click Save changes.", "warn");
    });
  }

  // ─── Editing-mode picker + form interactions ─────────────────────────
  pickerSelect.addEventListener("change", () => {
    const doc = getDoc(pickerSelect.value);
    if (doc) {
      currentDoc = doc;
      form.setDoc(doc);
      updateStrengthMeter();
      setPickerStatus("");
    }
  });
  pickerNew.addEventListener("click", () => {
    const blank = emptyVoiceDoc();
    currentDoc = blank;
    form.setDoc(blank);
    pickerSelect.value = "";
    updateStrengthMeter();
    setPickerStatus("New blank doc — give it a client name and save.", "warn");
  });
  pickerDup.addEventListener("click", () => {
    if (!pickerSelect.value) {
      setPickerStatus("Select a doc to duplicate.", "warn");
      return;
    }
    const copy = duplicateDoc(pickerSelect.value);
    if (copy) {
      currentDoc = copy;
      populatePickerSelect();
      populateSummarySwitcher();
      pickerSelect.value = copy.id;
      form.setDoc(copy);
      updateStrengthMeter();
      setPickerStatus(`Duplicated as "${copy.client_name}".`, "saved");
    }
  });
  pickerDel.addEventListener("click", () => {
    const id = pickerSelect.value;
    if (!id) {
      setPickerStatus("Select a doc to delete.", "warn");
      return;
    }
    if (id.startsWith(SAMPLE_ID_PREFIX)) {
      setPickerStatus(
        "Sample docs can't be deleted (they re-seed on next visit). Duplicate it first if you want to modify.",
        "warn"
      );
      return;
    }
    const doc = getDoc(id);
    if (!doc) return;
    if (!confirm(`Delete "${doc.client_name}"? This can't be undone.`)) return;
    deleteDoc(id);
    populatePickerSelect();
    populateSummarySwitcher();
    // Reset to first remaining doc.
    const remaining = listDocs();
    if (remaining.length > 0) {
      currentDoc = remaining[0];
      pickerSelect.value = currentDoc.id;
      form.setDoc(currentDoc);
    } else {
      currentDoc = emptyVoiceDoc();
      form.setDoc(currentDoc);
    }
    updateStrengthMeter();
    setPickerStatus("Deleted.", "saved");
  });
  pickerSave.addEventListener("click", () => {
    const saved = persistCurrent();
    if (saved) setPickerStatus(`Saved "${saved.client_name}".`, "saved");
  });

  doneEditingBtn.addEventListener("click", () => {
    const saved = persistCurrent();
    if (!saved) return; // validation failed; stay in editing
    currentDoc = saved;
    exitImportOnlyMode();
    populatePickerSelect();
    populateSummarySwitcher();
    summarySwitcher.value = saved.id;
    setMode("summary");
  });
  cancelEditingBtn.addEventListener("click", () => {
    exitImportOnlyMode();
    if (editingBaselineId) {
      const baseline = getDoc(editingBaselineId);
      if (baseline) {
        currentDoc = baseline;
        form.setDoc(baseline);
        setMode("summary");
        return;
      }
    }
    // No baseline (was creating a new doc) — back to empty if no saved docs,
    // else go to summary with first doc.
    const docs = listDocs();
    if (docs.length === 0) setMode("empty");
    else {
      currentDoc = docs[0];
      pickerSelect.value = currentDoc.id;
      form.setDoc(currentDoc);
      setMode("summary");
    }
  });

  function persistCurrent(): VoiceDoc | null {
    const doc = form.readDoc();
    if (!doc.client_name.trim()) {
      setPickerStatus("Add a client name before saving.", "warn");
      return null;
    }
    return saveDoc(doc);
  }

  function setPickerStatus(message: string, state?: "saved" | "warn"): void {
    pickerStatus.textContent = message;
    if (state) pickerStatus.dataset.state = state;
    else delete pickerStatus.dataset.state;
  }

  // ─── Strength meter + summary rendering ──────────────────────────────
  function updateStrengthMeter(): void {
    const strength = computeDocStrength(currentDoc);
    strengthScore.textContent = String(strength.score);
    strengthSummary.textContent = strength.summary;
    strengthBox.dataset.band = bandLabelFor(strength.score);
    updateSubmitEnabled();
  }

  function renderSummary(): void {
    const strength = computeDocStrength(currentDoc);
    summaryClient.textContent = currentDoc.client_name || "(untitled doc)";
    summaryVertical.textContent = currentDoc.vertical || "";
    summaryScore.textContent = String(strength.score);
    summaryRoot.dataset.band = bandLabelFor(strength.score);
    const tones = currentDoc.tone_words.filter((t) => t.trim()).join(" · ");
    summaryTone.textContent = tones || "(no tone words set)";
    summaryStats.textContent = [
      `${currentDoc.banned_words.length} banned words`,
      `${currentDoc.voice_on_examples.length} voice-on examples`,
      `${currentDoc.voice_off_examples.length} voice-off examples`,
      `${currentDoc.examples_gallery.length} gallery entries`,
    ].join(" · ");
  }

  function bandLabelFor(score: number): string {
    if (score >= 9) return "strong";
    if (score >= 7) return "solid";
    if (score >= 5) return "workable";
    return "weak";
  }

  // ─── Picker + summary-switcher option lists ──────────────────────────
  function populatePickerSelect(): void {
    const docs = listDocs();
    pickerSelect.innerHTML = "";
    if (docs.length === 0) {
      const opt = document.createElement("option");
      opt.value = "";
      opt.textContent = "(no saved docs yet)";
      pickerSelect.appendChild(opt);
      return;
    }
    for (const d of docs) {
      const opt = document.createElement("option");
      opt.value = d.id;
      const isSample = d.id.startsWith(SAMPLE_ID_PREFIX);
      opt.textContent = isSample ? `${d.client_name} — sample` : d.client_name;
      pickerSelect.appendChild(opt);
    }
  }
  function populateSummarySwitcher(): void {
    const docs = listDocs();
    summarySwitcher.innerHTML = "";
    if (docs.length === 0) {
      const opt = document.createElement("option");
      opt.value = "";
      opt.textContent = "(no saved docs)";
      summarySwitcher.appendChild(opt);
      return;
    }
    for (const d of docs) {
      const opt = document.createElement("option");
      opt.value = d.id;
      const isSample = d.id.startsWith(SAMPLE_ID_PREFIX);
      opt.textContent = isSample ? `${d.client_name} — sample` : d.client_name;
      summarySwitcher.appendChild(opt);
    }
  }

  // ─── Upload + critique ───────────────────────────────────────────────
  if (uploadDrop && uploadInput) {
    ["dragenter", "dragover"].forEach((evt) => {
      uploadDrop.addEventListener(evt, (e) => {
        e.preventDefault();
        uploadDrop.dataset.drag = "over";
      });
    });
    ["dragleave", "drop"].forEach((evt) => {
      uploadDrop.addEventListener(evt, (e) => {
        e.preventDefault();
        delete uploadDrop.dataset.drag;
      });
    });
    uploadDrop.addEventListener("drop", (e) => {
      const dt = (e as DragEvent).dataTransfer;
      const f = dt?.files?.[0];
      if (f) void handleUpload(f);
    });
    uploadInput.addEventListener("change", () => {
      const f = uploadInput.files?.[0];
      if (f) void handleUpload(f);
    });
  }

  async function handleUpload(file: File): Promise<void> {
    if (!uploadDrop || !uploadStatus) return;
    uploadDrop.dataset.state = "busy";
    uploadStatus.dataset.state = "";
    uploadStatus.textContent = `Reading ${file.name}…`;
    try {
      const body = new FormData();
      body.append("file", file);
      uploadStatus.textContent = "Extracting structure and analyzing…";
      const res = await fetch("/api/import-doc", { method: "POST", body });
      const payload = (await res.json()) as ApiResponse<ImportResult>;
      if (!payload.ok) {
        uploadStatus.dataset.state = "error";
        uploadStatus.textContent = payload.message;
        delete uploadDrop.dataset.state;
        return;
      }
      uploadStatus.dataset.state = "success";
      uploadStatus.textContent = payload.data.cached
        ? "Re-imported from cache (identical to a previous upload)."
        : `Imported ${payload.data.filename}. Review the suggestions, then click Save changes.`;
      delete uploadDrop.dataset.state;
      applyImport(payload.data);
    } catch (err) {
      uploadStatus.dataset.state = "error";
      uploadStatus.textContent = "Upload failed. Try again.";
      delete uploadDrop.dataset.state;
    }
  }

  function applyImport(result: ImportResult): void {
    currentDoc = result.doc;
    form.setDoc(result.doc);
    pickerSelect.value = "";
    updateStrengthMeter();
    renderCritique(result);
    // Reveal the full editing view (form, picker, samples) now that there's
    // something to review — import-only mode is no longer appropriate.
    exitImportOnlyMode();
    setPickerStatus(
      `Imported "${result.doc.client_name}" from ${result.filename}. Review and save.`,
      "saved"
    );
    if (uploadDetails) uploadDetails.open = false;
    if (critiquePanel) critiquePanel.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  const SECTION_LABELS: Record<number, string> = {
    1: "Tone words",
    2: "Banned words",
    3: "Cadence rules",
    4: "Voice-on examples",
    5: "Voice-off examples",
    6: "Punctuation",
    7: "CTA rules",
    8: "Terminology",
    9: "Exceptions",
    10: "Examples gallery",
  };

  function renderCritique(result: ImportResult): void {
    if (!critiquePanel) return;
    critiquePanel.hidden = false;
    const scoreEl = critiquePanel.querySelector('[data-field="critique_score"]') as HTMLElement;
    const summaryEl = critiquePanel.querySelector('[data-field="critique_summary"]') as HTMLElement;
    scoreEl.textContent = String(result.strength.score);
    summaryEl.textContent = result.strength.summary;
    critiquePanel.dataset.band = bandLabelFor(result.strength.score);

    const sectionsList = critiquePanel.querySelector('[data-field="critique_sections"]') as HTMLElement;
    sectionsList.innerHTML = "";
    for (const s of result.strength.sections) {
      const li = document.createElement("li");
      const pill = document.createElement("span");
      pill.className = "critique__pill";
      pill.dataset.status = s.status;
      pill.textContent = s.status;
      const text = document.createElement("span");
      text.textContent = `${SECTION_LABELS[s.section] ?? s.label} — ${s.reason}`;
      li.appendChild(pill);
      li.appendChild(text);
      sectionsList.appendChild(li);
    }

    const sugList = critiquePanel.querySelector('[data-field="critique_suggestions"]') as HTMLElement;
    const sugEmpty = critiquePanel.querySelector('[data-field="critique_no_suggestions"]') as HTMLElement;
    sugList.innerHTML = "";
    if (!result.suggestions || result.suggestions.length === 0) {
      sugList.hidden = true;
      sugEmpty.hidden = false;
    } else {
      sugList.hidden = false;
      sugEmpty.hidden = true;
      for (const sug of result.suggestions) {
        const li = document.createElement("li");
        const head = document.createElement("div");
        head.className = "critique__suggestion-head";
        const section = document.createElement("span");
        section.className = "critique__suggestion-section";
        section.textContent = SECTION_LABELS[sug.section] ?? sug.section_label;
        head.appendChild(section);
        if (Array.isArray(sug.example_items) && sug.example_items.length > 0) {
          const apply = document.createElement("button");
          apply.type = "button";
          apply.className = "btn btn--ghost btn--small";
          apply.textContent = "Apply →";
          apply.addEventListener("click", () => {
            applySuggestion(sug);
            apply.textContent = "Applied";
            apply.disabled = true;
          });
          head.appendChild(apply);
        }
        const text = document.createElement("p");
        text.className = "critique__suggestion-text";
        text.textContent = sug.suggestion;
        li.appendChild(head);
        li.appendChild(text);
        if (Array.isArray(sug.example_items) && sug.example_items.length > 0) {
          const exList = document.createElement("ul");
          exList.className = "critique__suggestion-examples";
          for (const item of sug.example_items) {
            const exLi = document.createElement("li");
            exLi.textContent = typeof item === "string" ? item : JSON.stringify(item);
            exList.appendChild(exLi);
          }
          li.appendChild(exList);
        }
        sugList.appendChild(li);
      }
    }
  }

  function applySuggestion(sug: ImportResult["suggestions"][number]): void {
    const doc = form.readDoc();
    const items = sug.example_items ?? [];
    switch (sug.section) {
      case 2:
        for (const it of items) {
          if (typeof it === "string") doc.banned_words.push({ word: it });
          else if (typeof it === "object" && "word" in (it as any))
            doc.banned_words.push(it as { word: string; reason?: string });
        }
        break;
      case 3:
        for (const it of items) {
          if (typeof it === "string") doc.cadence_rules.push(it);
        }
        break;
      case 4:
        for (const it of items) {
          if (typeof it === "string") doc.voice_on_examples.push(it);
        }
        break;
      case 5:
        for (const it of items) {
          if (typeof it === "object" && "example" in (it as any)) {
            doc.voice_off_examples.push(it as { example: string; why_wrong: string });
          }
        }
        break;
      case 8:
        for (const it of items) {
          if (typeof it === "object" && "use" in (it as any) && "not" in (it as any)) {
            doc.required_terms.push(it as { use: string; not: string; note?: string });
          }
        }
        break;
      case 10:
        for (const it of items) {
          if (typeof it === "string") doc.examples_gallery.push(it);
        }
        break;
    }
    form.setDoc(doc);
    currentDoc = doc;
    updateStrengthMeter();
  }

  const critiqueCloseBtn = editingView.querySelector('[data-critique-close]') as HTMLButtonElement | null;
  if (critiqueCloseBtn && critiquePanel) {
    critiqueCloseBtn.addEventListener("click", () => (critiquePanel.hidden = true));
  }

  // ─── Submit: score the draft against the current doc ────────────────
  submitBtn.addEventListener("click", async () => {
    const doc = currentDoc;
    const draft = draftInput.value.trim();
    if (!draft) {
      draftInput.focus();
      return;
    }
    if (!doc.client_name.trim() || doc.banned_words.length + doc.voice_on_examples.length === 0) {
      if (hint) hint.textContent = "Voice doc is too thin to score. Edit it and add banned words + voice-on examples first.";
      return;
    }

    submitBtn.disabled = true;
    if (hint) hint.textContent = "";
    if (wall) wall.hidden = true;
    if (loading) {
      loading.hidden = false;
      loading.dataset.stage = "reading";
    }
    const t1 = window.setTimeout(() => {
      if (loading) loading.dataset.stage = "extracting";
    }, 800);

    try {
      const res = await fetch("/api/check", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ voiceDoc: doc, draft }),
      });
      const payload = (await res.json()) as ApiResponse<VoiceResult>;
      window.clearTimeout(t1);

      if (!payload.ok) {
        if (payload.error === "rate_limit_exceeded" && wall) {
          wall.hidden = false;
          wall.scrollIntoView({ behavior: "smooth", block: "start" });
        } else if (hint) {
          hint.textContent = payload.message;
        }
        return;
      }

      if (loading) loading.dataset.stage = "done";
      (window as any).__lastResult = payload.data;
      render(payload.data, draft);
      if (hint && Number.isFinite(payload.remaining)) {
        hint.textContent =
          payload.remaining > 0
            ? `${payload.remaining} demo run${payload.remaining === 1 ? "" : "s"} remaining`
            : "Last demo run used — fork to keep going.";
      }
    } catch {
      if (hint) hint.textContent = "Network error. Try again.";
    } finally {
      updateSubmitEnabled();
      window.setTimeout(() => {
        if (loading) loading.hidden = true;
      }, 600);
    }
  });

  // Copy actions on the result panel.
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const data = (window as any).__lastResult as VoiceResult | undefined;
      if (!data) return;
      const text =
        btn.dataset.copy === "rewrite" ? data.rewritten_draft : formatFlags(data);
      navigator.clipboard.writeText(text);
      const orig = btn.textContent;
      btn.textContent = "Copied!";
      setTimeout(() => (btn.textContent = orig), 1400);
    });
  });

  function render(data: VoiceResult, originalDraft: string) {
    if (!resultPanel || !resultStage) return;
    resultStage.hidden = false;
    resultPanel.hidden = false;

    const bandEl = resultPanel.querySelector(".band") as HTMLElement;
    const bandLabel = resultPanel.querySelector('[data-field="band_label"]') as HTMLElement;
    const compositeEl = resultPanel.querySelector('[data-field="composite_score"]') as HTMLElement;
    const confidenceEl = resultPanel.querySelector('[data-field="confidence_badge"]') as HTMLElement;
    const reason = resultPanel.querySelector('[data-field="score_reason"]') as HTMLElement;

    bandEl.dataset.band = data.band;
    bandLabel.textContent = data.band_label;
    compositeEl.textContent = String(data.composite_score);
    if (data.confidence === "high") {
      confidenceEl.hidden = true;
    } else {
      confidenceEl.hidden = false;
      confidenceEl.dataset.confidence = data.confidence;
      confidenceEl.textContent =
        data.confidence === "medium" ? "Medium confidence" : "Low confidence";
    }
    reason.textContent = data.score_reason;

    renderSubScores(data);

    const draftEl = resultPanel.querySelector('[data-field="highlightedDraft"]') as HTMLElement;
    draftEl.innerHTML = highlight(originalDraft, data.flags.map((f) => f.phrase));

    const flagsList = resultPanel.querySelector('[data-field="flags"]') as HTMLElement;
    const flagsEmpty = resultPanel.querySelector('[data-field="flagsEmpty"]') as HTMLElement;
    flagsList.innerHTML = "";
    if (data.flags.length === 0) {
      flagsEmpty.hidden = false;
    } else {
      flagsEmpty.hidden = true;
      data.flags.forEach((f) => {
        const li = document.createElement("li");
        const phrase = document.createElement("p");
        phrase.className = "flag__phrase";
        phrase.textContent = f.phrase;
        const rule = document.createElement("p");
        rule.className = "flag__rule";
        rule.textContent = f.rule_cited;
        const rewrite = document.createElement("p");
        rewrite.className = "flag__rewrite";
        const label = document.createElement("span");
        label.className = "flag__rewrite-label";
        label.textContent = "Try:";
        rewrite.appendChild(label);
        rewrite.appendChild(document.createTextNode(" " + f.suggested_rewrite));
        li.appendChild(phrase);
        li.appendChild(rule);
        li.appendChild(rewrite);
        flagsList.appendChild(li);
      });
    }

    const rewritten = resultPanel.querySelector('[data-field="rewritten_draft"]') as HTMLElement;
    rewritten.textContent = data.rewritten_draft;

    resultStage.scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function renderSubScores(data: VoiceResult) {
    if (!resultPanel) return;
    const keys = ["vocabulary", "punctuation", "tone", "cadence"] as const;
    for (const key of keys) {
      const el = resultPanel.querySelector(`.subscore[data-key="${key}"]`) as HTMLElement | null;
      if (!el) continue;
      const value = data.sub_scores[key];
      const valueEl = el.querySelector(".subscore__value") as HTMLElement;
      const fillEl = el.querySelector(".subscore__fill") as HTMLElement;
      valueEl.textContent = String(value);
      fillEl.style.width = `${Math.max(0, Math.min(100, value))}%`;
      el.dataset.band = subBandFor(value);
    }
  }

  function subBandFor(score: number): string {
    if (score >= 90) return "on-brand";
    if (score >= 75) return "mostly-on-brand";
    if (score >= 55) return "drifting";
    if (score >= 35) return "off-brand";
    return "rewrite-needed";
  }

  function highlight(text: string, phrases: string[]): string {
    if (phrases.length === 0) return escapeHtml(text);
    const sorted = [...new Set(phrases)].sort((a, b) => b.length - a.length);
    let out = "";
    let cursor = 0;
    while (cursor < text.length) {
      let bestIdx = -1;
      let bestPhrase = "";
      for (const p of sorted) {
        if (!p) continue;
        const idx = text.indexOf(p, cursor);
        if (idx !== -1 && (bestIdx === -1 || idx < bestIdx)) {
          bestIdx = idx;
          bestPhrase = p;
        }
      }
      if (bestIdx === -1) {
        out += escapeHtml(text.slice(cursor));
        break;
      }
      out += escapeHtml(text.slice(cursor, bestIdx));
      out += `<mark>${escapeHtml(bestPhrase)}</mark>`;
      cursor = bestIdx + bestPhrase.length;
    }
    return out;
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function formatFlags(d: VoiceResult): string {
    const header = `${d.band_label} — ${d.composite_score}/100 (${d.confidence} confidence)`;
    const sub = `Sub-scores: vocabulary ${d.sub_scores.vocabulary} · punctuation ${d.sub_scores.punctuation} · tone ${d.sub_scores.tone} · cadence ${d.sub_scores.cadence}`;
    if (d.flags.length === 0) {
      return `${header}\n${sub}\n${d.score_reason}\nNo flags.`;
    }
    return [
      header,
      sub,
      d.score_reason,
      "",
      ...d.flags.map(
        (f, i) =>
          `${i + 1}. "${f.phrase}" — violates: ${f.rule_cited}\n   Try: ${f.suggested_rewrite}`
      ),
    ].join("\n");
  }
</script>
